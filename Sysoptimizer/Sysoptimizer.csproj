<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Sysoptimizer</AssemblyName>
    <Version>1.19.1</Version>
    <Product>Sysoptimizer</Product>
    <AssemblyTitle>Sysoptimizer</AssemblyTitle>
    <Description>A Windows 10/11 tune-up tool that shows what it is about to change, and can change it back</Description>
    <Company>Protagonist Labs</Company>
    <Authors>Protagonist Labs</Authors>
    <Copyright>Copyright (c) 2026 Protagonist Labs. MIT licence</Copyright>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
  </ItemGroup>

  <!-- UseWindowsForms is only here for FolderBrowserDialog (fully-qualified at every call site); its
       implicit usings otherwise collide with WPF's own Point/Application/HorizontalAlignment project-wide. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
