<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Night City: near-black panels, hard corners, hazard yellow only for what you can press or have selected,
         neon cyan, hot magenta and electric violet on the graphs, soft terminal cyan for the log. -->

    <!-- Surfaces and text -->
    <SolidColorBrush x:Key="Surface" Color="#FF0A0A0E" />
    <SolidColorBrush x:Key="SurfaceElevated" Color="#FF121218" />
    <SolidColorBrush x:Key="Border" Color="#FF3A3520" />
    <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF16161D" Offset="0" />
        <GradientStop Color="#FF0E0E13" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TextPrimary" Color="#FFECE9DA" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FF9A957C" />
    <SolidColorBrush x:Key="LogForeground" Color="#FF8FE9EF" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent" Color="#FFFCEE0A" />
    <SolidColorBrush x:Key="AccentDim" Color="#44FCEE0A" />
    <SolidColorBrush x:Key="OnAccent" Color="#FF0A0A0E" />

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#FF5A5848" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#B0FCEE0A" />
    <SolidColorBrush x:Key="ScrollThumbActive" Color="#FFFCEE0A" />

    <!-- One color per metric for CPU / Memory / GPU -->
    <SolidColorBrush x:Key="AccentCpu" Color="#FF00E5F0" />
    <SolidColorBrush x:Key="AccentMem" Color="#FFFF2A6D" />
    <SolidColorBrush x:Key="AccentGpu" Color="#FFB967FF" />

    <!-- Good / warning / bad: the health score, and the warm and hot steps of the History heat ramp.
         Picked to step away from the metric colors above. -->
    <SolidColorBrush x:Key="StatusGood" Color="#FF3DDC97" />
    <SolidColorBrush x:Key="StatusWarn" Color="#FFFF8A00" />
    <SolidColorBrush x:Key="StatusBad" Color="#FFFF3B1F" />
    <!-- Temperature band under the History chart: dim teal at rest, amber by 78 °C, StatusBad at 90 °C -->
    <SolidColorBrush x:Key="TempCool" Color="#FF1F6170" />
    <SolidColorBrush x:Key="TempWarm" Color="#FFFF8A00" />

    <!-- Tabs: flat black plates; the open one a shade lighter, with yellow text and a yellow underline -->
    <SolidColorBrush x:Key="TabBackground" Color="#FF121218" />
    <SolidColorBrush x:Key="TabBackgroundSelected" Color="#FF1A1A22" />
    <SolidColorBrush x:Key="TabForeground" Color="#FF9A957C" />
    <SolidColorBrush x:Key="TabForegroundSelected" Color="#FFFCEE0A" />
    <SolidColorBrush x:Key="TabIndicator" Color="#FFFCEE0A" />
    <Thickness x:Key="TabIndicatorThickness">0,0,0,2</Thickness>
    <Thickness x:Key="TabMargin">0,0,2,0</Thickness>
    <Thickness x:Key="TabPadding">13,10</Thickness>

    <!-- Buttons, pills, checkboxes -->
    <LinearGradientBrush x:Key="ButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1E1E26" Offset="0" />
        <GradientStop Color="#FF141419" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFECE9DA" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#FF6E6A55" />
    <SolidColorBrush x:Key="ButtonHoverBorder" Color="#FFFCEE0A" />
    <SolidColorBrush x:Key="PillBackground" Color="#FF121218" />
    <SolidColorBrush x:Key="PillForeground" Color="#FF9A957C" />
    <!-- Checked pill: solid hazard yellow, like everything you can press -->
    <SolidColorBrush x:Key="PillBackgroundSelected" Color="#FFFCEE0A" />
    <SolidColorBrush x:Key="PillBorderSelected" Color="#FFFCEE0A" />
    <SolidColorBrush x:Key="PillForegroundSelected" Color="#FF0A0A0E" />
    <SolidColorBrush x:Key="CheckBorder" Color="#FF7A7458" />
    <Thickness x:Key="ControlBorderThickness">1</Thickness>

    <!-- Shape: hard corners -->
    <CornerRadius x:Key="CardRadius">2</CornerRadius>
    <CornerRadius x:Key="ControlRadius">2</CornerRadius>
    <CornerRadius x:Key="PillRadius">2</CornerRadius>
    <CornerRadius x:Key="CheckRadius">0</CornerRadius>
    <CornerRadius x:Key="PopupRadius">2</CornerRadius>
    <CornerRadius x:Key="TabRadius">0</CornerRadius>

    <!-- Type and line weight -->
    <FontFamily x:Key="UiFont">Bahnschrift, Segoe UI Variable, Segoe UI</FontFamily>
    <sys:Double x:Key="GraphStroke">1.8</sys:Double>

    <!-- Glow -->
    <DropShadowEffect x:Key="LineGlow" Color="#FCEE0A" BlurRadius="6" ShadowDepth="0" Opacity="0.3" />
    <DropShadowEffect x:Key="LineGlowCpu" Color="#00E5F0" BlurRadius="8" ShadowDepth="0" Opacity="0.5" />
    <DropShadowEffect x:Key="LineGlowMem" Color="#FF2A6D" BlurRadius="8" ShadowDepth="0" Opacity="0.5" />
    <DropShadowEffect x:Key="LineGlowGpu" Color="#B967FF" BlurRadius="8" ShadowDepth="0" Opacity="0.5" />

    <!-- Area under each curve -->
    <LinearGradientBrush x:Key="AreaFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#30FCEE0A" Offset="0" />
        <GradientStop Color="#00FCEE0A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AreaFillCpu" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3800E5F0" Offset="0" />
        <GradientStop Color="#0000E5F0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AreaFillMem" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38FF2A6D" Offset="0" />
        <GradientStop Color="#00FF2A6D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AreaFillGpu" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38B967FF" Offset="0" />
        <GradientStop Color="#00B967FF" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
