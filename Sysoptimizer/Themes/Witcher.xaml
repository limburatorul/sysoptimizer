<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Kaer Morhen: dark steel and worn leather, parchment text, silver for what you can press, and the graphs in the colours of the Signs — Igni red, Aard blue and Quen gold. -->

    <!-- Surfaces and text -->
    <SolidColorBrush x:Key="Surface" Color="#FF0E0D0C" />
    <SolidColorBrush x:Key="SurfaceElevated" Color="#FF181614" />
    <SolidColorBrush x:Key="Border" Color="#FF3A342C" />
    <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1C1917" Offset="0" />
        <GradientStop Color="#FF100F0E" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TextPrimary" Color="#FFE8E0D0" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FF9A8F7E" />
    <SolidColorBrush x:Key="LogForeground" Color="#FFD9C9A3" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent" Color="#FFC9CED6" />
    <SolidColorBrush x:Key="AccentDim" Color="#40C9CED6" />
    <SolidColorBrush x:Key="OnAccent" Color="#FF121110" />

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#FF4A443B" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#B0C9CED6" />
    <SolidColorBrush x:Key="ScrollThumbActive" Color="#FFC9CED6" />

    <!-- One color per metric for CPU / Memory / GPU -->
    <SolidColorBrush x:Key="AccentCpu" Color="#FFE0483A" />
    <SolidColorBrush x:Key="AccentMem" Color="#FF5DA9E9" />
    <SolidColorBrush x:Key="AccentGpu" Color="#FFE2B13C" />

    <!-- Good / warning / bad -->
    <SolidColorBrush x:Key="StatusGood" Color="#FF86B05A" />
    <SolidColorBrush x:Key="StatusWarn" Color="#FFE2B13C" />
    <SolidColorBrush x:Key="StatusBad" Color="#FFE0483A" />
    <!-- Temperature band under the History chart: cool at rest, warm by 78 °C, StatusBad at 90 °C -->
    <SolidColorBrush x:Key="TempCool" Color="#FF3C3428" />
    <SolidColorBrush x:Key="TempWarm" Color="#FFE2B13C" />

    <!-- Tabs -->
    <SolidColorBrush x:Key="TabBackground" Color="#FF0E0D0C" />
    <SolidColorBrush x:Key="TabBackgroundSelected" Color="#FF181614" />
    <SolidColorBrush x:Key="TabForeground" Color="#FF9A8F7E" />
    <SolidColorBrush x:Key="TabForegroundSelected" Color="#FFE8E0D0" />
    <SolidColorBrush x:Key="TabIndicator" Color="#FFB8202B" />
    <Thickness x:Key="TabIndicatorThickness">0,0,0,2</Thickness>
    <Thickness x:Key="TabMargin">0,0,2,0</Thickness>
    <Thickness x:Key="TabPadding">13,10</Thickness>

    <!-- Buttons, pills, checkboxes -->
    <LinearGradientBrush x:Key="ButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF221F1C" Offset="0" />
        <GradientStop Color="#FF161412" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFE8E0D0" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#FF5A5246" />
    <SolidColorBrush x:Key="ButtonHoverBorder" Color="#FFC9CED6" />
    <SolidColorBrush x:Key="PillBackground" Color="#FF181614" />
    <SolidColorBrush x:Key="PillForeground" Color="#FF9A8F7E" />
    <SolidColorBrush x:Key="PillBackgroundSelected" Color="#FFC9CED6" />
    <SolidColorBrush x:Key="PillBorderSelected" Color="#FFC9CED6" />
    <SolidColorBrush x:Key="PillForegroundSelected" Color="#FF121110" />
    <SolidColorBrush x:Key="CheckBorder" Color="#FF5A5246" />
    <Thickness x:Key="ControlBorderThickness">1</Thickness>

    <!-- Shape -->
    <CornerRadius x:Key="CardRadius">2</CornerRadius>
    <CornerRadius x:Key="ControlRadius">2</CornerRadius>
    <CornerRadius x:Key="PillRadius">2</CornerRadius>
    <CornerRadius x:Key="CheckRadius">1</CornerRadius>
    <CornerRadius x:Key="PopupRadius">2</CornerRadius>
    <CornerRadius x:Key="TabRadius">0</CornerRadius>

    <!-- Type and line weight -->
    <FontFamily x:Key="UiFont">Cambria, Segoe UI</FontFamily>
    <sys:Double x:Key="GraphStroke">1.8</sys:Double>

    <!-- Glow -->
    <DropShadowEffect x:Key="LineGlow" Color="#C9CED6" BlurRadius="12" ShadowDepth="0" Opacity="0.5" />
    <DropShadowEffect x:Key="LineGlowCpu" Color="#E0483A" BlurRadius="16" ShadowDepth="0" Opacity="0.8" />
    <DropShadowEffect x:Key="LineGlowMem" Color="#5DA9E9" BlurRadius="16" ShadowDepth="0" Opacity="0.8" />
    <DropShadowEffect x:Key="LineGlowGpu" Color="#E2B13C" BlurRadius="16" ShadowDepth="0" Opacity="0.8" />

    <!-- Area under each curve -->
    <LinearGradientBrush x:Key="AreaFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38C9CED6" Offset="0" />
        <GradientStop Color="#00C9CED6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AreaFillCpu" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40E0483A" Offset="0" />
        <GradientStop Color="#00E0483A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AreaFillMem" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#405DA9E9" Offset="0" />
        <GradientStop Color="#005DA9E9" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AreaFillGpu" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40E2B13C" Offset="0" />
        <GradientStop Color="#00E2B13C" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
