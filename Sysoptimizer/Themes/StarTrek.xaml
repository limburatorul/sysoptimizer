<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- LCARS: black ground, solid pastel pills with black labels, peach and violet text.
         Palette follows the Star Trek: The Next Generation panels — orange #FF9900, violet #CC99CC,
         peach #FFCC99, lilac #CC99FF, sky #99CCFF. -->

    <!-- Surfaces and text -->
    <SolidColorBrush x:Key="Surface" Color="#FF000000" />
    <SolidColorBrush x:Key="SurfaceElevated" Color="#FF0B0B12" />
    <SolidColorBrush x:Key="Border" Color="#80CC99CC" />
    <SolidColorBrush x:Key="CardBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFCC99" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FFCC99CC" />
    <SolidColorBrush x:Key="LogForeground" Color="#FFFFCC99" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent" Color="#FFFF9900" />
    <SolidColorBrush x:Key="AccentDim" Color="#44FF9900" />
    <SolidColorBrush x:Key="OnAccent" Color="#FF000000" />

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#80CC99CC" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#B3FF9900" />
    <SolidColorBrush x:Key="ScrollThumbActive" Color="#FFFF9900" />

    <!-- One color per metric for CPU / Memory / GPU -->
    <SolidColorBrush x:Key="AccentCpu" Color="#FFFF9900" />
    <SolidColorBrush x:Key="AccentMem" Color="#FFCC99FF" />
    <SolidColorBrush x:Key="AccentGpu" Color="#FF99CCFF" />

    <!-- Tabs: every tab is a violet pill, the open one turns orange -->
    <SolidColorBrush x:Key="TabBackground" Color="#FFCC99CC" />
    <SolidColorBrush x:Key="TabBackgroundSelected" Color="#FFFF9900" />
    <SolidColorBrush x:Key="TabForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="TabForegroundSelected" Color="#FF000000" />
    <SolidColorBrush x:Key="TabIndicator" Color="#FFFF9900" />
    <Thickness x:Key="TabIndicatorThickness">0</Thickness>
    <Thickness x:Key="TabMargin">2,6,2,6</Thickness>
    <Thickness x:Key="TabPadding">10,5</Thickness>

    <!-- Buttons, pills, checkboxes -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFCC99" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="ButtonBorder" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonHoverBorder" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PillBackground" Color="#FFCC99CC" />
    <SolidColorBrush x:Key="PillForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="CheckBorder" Color="#FFFF9900" />
    <Thickness x:Key="ControlBorderThickness">2</Thickness>

    <!-- Shape: LCARS is round -->
    <CornerRadius x:Key="CardRadius">26</CornerRadius>
    <CornerRadius x:Key="ControlRadius">17</CornerRadius>
    <CornerRadius x:Key="PillRadius">14</CornerRadius>
    <CornerRadius x:Key="CheckRadius">9</CornerRadius>
    <CornerRadius x:Key="PopupRadius">10</CornerRadius>
    <CornerRadius x:Key="TabRadius">15</CornerRadius>

    <!-- Type and line weight -->
    <FontFamily x:Key="UiFont">Bahnschrift SemiCondensed, Bahnschrift, Segoe UI</FontFamily>
    <sys:Double x:Key="GraphStroke">2.2</sys:Double>

    <!-- Glow -->
    <DropShadowEffect x:Key="LineGlow" Color="#FF9900" BlurRadius="10" ShadowDepth="0" Opacity="0.7" />
    <DropShadowEffect x:Key="LineGlowCpu" Color="#FF9900" BlurRadius="16" ShadowDepth="0" Opacity="0.9" />
    <DropShadowEffect x:Key="LineGlowMem" Color="#CC99FF" BlurRadius="16" ShadowDepth="0" Opacity="0.9" />
    <DropShadowEffect x:Key="LineGlowGpu" Color="#99CCFF" BlurRadius="16" ShadowDepth="0" Opacity="0.9" />

    <!-- Area under each curve -->
    <LinearGradientBrush x:Key="AreaFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FF9900" Offset="0" />
        <GradientStop Color="#00FF9900" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AreaFillCpu" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FF9900" Offset="0" />
        <GradientStop Color="#00FF9900" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AreaFillMem" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66CC99FF" Offset="0" />
        <GradientStop Color="#00CC99FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AreaFillGpu" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6699CCFF" Offset="0" />
        <GradientStop Color="#0099CCFF" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
