<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Pip-Boy: a green phosphor screen. Black-green glass, square corners, a monospaced readout, and what's
         selected shown inverted — solid green with black text — the way the Pip-Boy highlights a line. The
         graphs stay in the phosphor family (green, yellow-green, amber) and glow like a CRT. -->

    <!-- Surfaces and text -->
    <SolidColorBrush x:Key="Surface" Color="#FF030A06" />
    <SolidColorBrush x:Key="SurfaceElevated" Color="#FF06140C" />
    <SolidColorBrush x:Key="Border" Color="#FF1B4A2E" />
    <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF071A0F" Offset="0" />
        <GradientStop Color="#FF040F08" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TextPrimary" Color="#FFA6FFC4" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FF4DA96F" />
    <SolidColorBrush x:Key="LogForeground" Color="#FF1AFF80" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent" Color="#FF1AFF80" />
    <SolidColorBrush x:Key="AccentDim" Color="#401AFF80" />
    <SolidColorBrush x:Key="OnAccent" Color="#FF030A06" />

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#FF1F5A37" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#B01AFF80" />
    <SolidColorBrush x:Key="ScrollThumbActive" Color="#FF1AFF80" />

    <!-- One color per metric for CPU / Memory / GPU -->
    <SolidColorBrush x:Key="AccentCpu" Color="#FF1AFF80" />
    <SolidColorBrush x:Key="AccentMem" Color="#FFC6FF4D" />
    <SolidColorBrush x:Key="AccentGpu" Color="#FFFFB641" />

    <!-- Good / warning / bad -->
    <SolidColorBrush x:Key="StatusGood" Color="#FF1AFF80" />
    <SolidColorBrush x:Key="StatusWarn" Color="#FFFFB641" />
    <SolidColorBrush x:Key="StatusBad" Color="#FFFF4F3A" />
    <!-- Temperature band under the History chart: dark phosphor at rest, amber by 78 °C, StatusBad at 90 °C -->
    <SolidColorBrush x:Key="TempCool" Color="#FF145A33" />
    <SolidColorBrush x:Key="TempWarm" Color="#FFFFB641" />

    <!-- Tabs: plain screen; the open one underlined in full phosphor -->
    <SolidColorBrush x:Key="TabBackground" Color="#FF030A06" />
    <SolidColorBrush x:Key="TabBackgroundSelected" Color="#FF06140C" />
    <SolidColorBrush x:Key="TabForeground" Color="#FF4DA96F" />
    <SolidColorBrush x:Key="TabForegroundSelected" Color="#FF1AFF80" />
    <SolidColorBrush x:Key="TabIndicator" Color="#FF1AFF80" />
    <Thickness x:Key="TabIndicatorThickness">0,0,0,2</Thickness>
    <Thickness x:Key="TabMargin">0,0,2,0</Thickness>
    <Thickness x:Key="TabPadding">13,10</Thickness>

    <!-- Buttons, pills, checkboxes -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#FF06140C" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFA6FFC4" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#FF2E7A4B" />
    <SolidColorBrush x:Key="ButtonHoverBorder" Color="#FF1AFF80" />
    <SolidColorBrush x:Key="PillBackground" Color="#FF06140C" />
    <SolidColorBrush x:Key="PillForeground" Color="#FF4DA96F" />
    <!-- Selected: inverted, as on the Pip-Boy -->
    <SolidColorBrush x:Key="PillBackgroundSelected" Color="#FF1AFF80" />
    <SolidColorBrush x:Key="PillBorderSelected" Color="#FF1AFF80" />
    <SolidColorBrush x:Key="PillForegroundSelected" Color="#FF030A06" />
    <SolidColorBrush x:Key="CheckBorder" Color="#FF2E7A4B" />
    <Thickness x:Key="ControlBorderThickness">1</Thickness>

    <!-- Shape: square, like a screen -->
    <CornerRadius x:Key="CardRadius">0</CornerRadius>
    <CornerRadius x:Key="ControlRadius">0</CornerRadius>
    <CornerRadius x:Key="PillRadius">0</CornerRadius>
    <CornerRadius x:Key="CheckRadius">0</CornerRadius>
    <CornerRadius x:Key="PopupRadius">0</CornerRadius>
    <CornerRadius x:Key="TabRadius">0</CornerRadius>

    <!-- Type and line weight: a monospaced readout -->
    <FontFamily x:Key="UiFont">Cascadia Mono, Consolas, Segoe UI</FontFamily>
    <sys:Double x:Key="GraphStroke">2</sys:Double>

    <!-- Glow: phosphor bloom -->
    <DropShadowEffect x:Key="LineGlow" Color="#1AFF80" BlurRadius="14" ShadowDepth="0" Opacity="0.7" />
    <DropShadowEffect x:Key="LineGlowCpu" Color="#1AFF80" BlurRadius="18" ShadowDepth="0" Opacity="0.95" />
    <DropShadowEffect x:Key="LineGlowMem" Color="#C6FF4D" BlurRadius="18" ShadowDepth="0" Opacity="0.95" />
    <DropShadowEffect x:Key="LineGlowGpu" Color="#FFB641" BlurRadius="18" ShadowDepth="0" Opacity="0.95" />

    <!-- Area under each curve -->
    <LinearGradientBrush x:Key="AreaFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#381AFF80" Offset="0" />
        <GradientStop Color="#001AFF80" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AreaFillCpu" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#401AFF80" Offset="0" />
        <GradientStop Color="#001AFF80" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AreaFillMem" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40C6FF4D" Offset="0" />
        <GradientStop Color="#00C6FF4D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AreaFillGpu" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40FFB641" Offset="0" />
        <GradientStop Color="#00FFB641" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
