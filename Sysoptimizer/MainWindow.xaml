                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="HistoryRangeList" ItemTemplate="{StaticResource HistoryAppRowTemplate}" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Disks">
                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
