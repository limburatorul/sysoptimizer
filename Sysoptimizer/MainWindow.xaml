<Window x:Class="Sysoptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sysoptimizer" Icon="app.ico" Height="916" Width="1055" MinHeight="916" MinWidth="1055"
        Background="Transparent" FontSize="13" FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <DataTemplate x:Key="HistoryRowTemplate">
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,5">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
        <!-- An event: clicking it (mouse or keyboard) opens History at that moment, pinned -->
        <DataTemplate x:Key="EventRowTemplate">
            <Button Click="EventRow_Click" Cursor="Hand" ToolTip="Show this moment in History" AutomationProperties.Name="{Binding Name}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HistoryRowTemplate}" />
            </Button>
        </DataTemplate>
        <!-- The same row, clickable (mouse or keyboard): charts that app in History -->
        <DataTemplate x:Key="HistoryAppRowTemplate">
            <Button Click="HistoryApp_Click" Cursor="Hand" ToolTip="Click to chart this app over time" AutomationProperties.Name="{Binding Name}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HistoryRowTemplate}" />
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Surface}">
            <TabControl x:Name="Tabs">

                <TabItem Header="Resources">
                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                        <StackPanel Margin="16">
                            <Border x:Name="HealthCardBorder" Padding="20" Margin="0,0,0,16" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" x:Name="OptimizeNowButton" Content="Optimize now" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="OptimizeNow_Click" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="SYSTEM HEALTH" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="SemiBold" />
                                        <DockPanel>
                                            <TextBlock VerticalAlignment="Center">
                                                <Run x:Name="HealthScoreText" Text="—" FontSize="44" FontWeight="Bold" Typography.NumeralAlignment="Tabular" /><Run Text="/100" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                                            </TextBlock>
                                            <ItemsControl x:Name="HealthIssuesList" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource CaseLabel}" Tag="Show last" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <RadioButton Content="30s" GroupName="Duration" Tag="30" Style="{StaticResource PillToggle}" Checked="DurationPill_Checked" />
                                    <RadioButton Content="1m" GroupName="Duration" Tag="60" Style="{StaticResource PillToggle}" IsChecked="True" Margin="6,0,0,0" Checked="DurationPill_Checked" />
                                    <RadioButton Content="2m" GroupName="Duration" Tag="120" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="DurationPill_Checked" />
                                    <RadioButton Content="5m" GroupName="Duration" Tag="300" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="DurationPill_Checked" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel>
                                <Border x:Name="CpuCardBorder" Height="150" Margin="0,0,0,10" Padding="0,14,0,0" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                                    <Grid x:Name="CpuGraphGrid">
                                        <Path x:Name="CpuAreaFill" Fill="{DynamicResource AreaFillCpu}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        <Path x:Name="CpuSparkline" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource AccentCpu}" StrokeThickness="{DynamicResource GraphStroke}"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Effect="{DynamicResource LineGlowCpu}" />
                                        <StackPanel VerticalAlignment="Top" Margin="14,0">
                                            <TextBlock Text="CPU" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                            <TextBlock x:Name="CpuPercentText" Text="0%" FontSize="26" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock x:Name="CpuDetailText" Text="" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        </StackPanel>
                                        <CheckBox x:Name="CpuPerThreadCheck" Content="Per thread" Style="{StaticResource PillToggle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,14,0"
                                                  Checked="CpuPerThread_Changed" Unchecked="CpuPerThread_Changed" />
                                        <UniformGrid x:Name="CpuThreadsGrid" Visibility="Collapsed" Margin="11,56,11,11" />
                                    </Grid>
                                </Border>
                                <Border x:Name="MemCardBorder" Height="150" Margin="0,0,0,10" Padding="0,14,0,0" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                                    <Grid x:Name="MemGraphGrid">
                                        <Path x:Name="MemAreaFill" Fill="{DynamicResource AreaFillMem}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        <Path x:Name="MemSparkline" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource AccentMem}" StrokeThickness="{DynamicResource GraphStroke}"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Effect="{DynamicResource LineGlowMem}" />
                                        <StackPanel VerticalAlignment="Top" Margin="14,0">
                                            <TextBlock Text="MEMORY" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                            <TextBlock x:Name="MemPercentText" Text="0%" FontSize="26" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock x:Name="MemDetailText" Text="0 / 0 GB" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        </StackPanel>
                                        <Button x:Name="FreeMemoryButton" Content="Free memory" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,14,0" Padding="10,3" FontSize="11" Click="TrimMemory_Click"
                                                ToolTip="Trims every process's working set: its pages move to standby or the pagefile, and free RAM rises right away. Apps read back what they use next, so they can feel slower for a moment. It doesn't make Windows faster in general." />
                                    </Grid>
                                </Border>
                                <Border x:Name="GpuCardBorder" Height="150" Padding="0,14,0,0" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                                    <Grid x:Name="GpuGraphGrid">
                                        <Path x:Name="GpuAreaFill" Fill="{DynamicResource AreaFillGpu}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        <Path x:Name="GpuSparkline" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource AccentGpu}" StrokeThickness="{DynamicResource GraphStroke}"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Effect="{DynamicResource LineGlowGpu}" />
                                        <StackPanel VerticalAlignment="Top" Margin="14,0">
                                            <TextBlock Text="GPU" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                            <TextBlock x:Name="GpuPercentText" Text="—" FontSize="26" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock x:Name="GpuDetailText" Text="Not available" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Padding="14,12" Margin="0,10,0,0" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CaseLabel}" Tag="Power &amp; cooling" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        <TextBlock x:Name="PowerText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock x:Name="FansText" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock x:Name="BatteryText" Visibility="Collapsed" FontSize="13" Margin="0,6,0,0" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Processes">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,14,16,0">
                            <RadioButton Content="Running" GroupName="ProcessesPages" Tag="{Binding ElementName=RunningPage}" Style="{StaticResource PillToggle}" IsChecked="True" Checked="SubPage_Checked" />
                            <RadioButton Content="Events" GroupName="ProcessesPages" Tag="{Binding ElementName=EventsPage}" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="SubPage_Checked" />
                            <RadioButton Content="Privacy" GroupName="ProcessesPages" Tag="{Binding ElementName=PrivacyPage}" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="SubPage_Checked" />
                        </StackPanel>
                        <Grid>
                            <Border x:Name="RunningPage">
                                <DockPanel Margin="16">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource CaseLabel}" Tag="Sort by" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                                            <RadioButton Content="CPU" GroupName="ProcessSort" Tag="cpu" Style="{StaticResource PillToggle}" IsChecked="True" Checked="ProcessSort_Checked" />
                                            <RadioButton Content="Memory" GroupName="ProcessSort" Tag="ram" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="ProcessSort_Checked" />
                                            <RadioButton Content="GPU" GroupName="ProcessSort" Tag="gpu" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="ProcessSort_Checked" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource CaseLabel}" Tag="Filter" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                                        <TextBox x:Name="ProcessFilterBox" Width="220" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center" TextChanged="ProcessFilter_Changed" />
                                    </DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                        <StackPanel x:Name="BlockedPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                            <TextBlock Text="BLOCKED APPS" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <ItemsControl x:Name="BlockedList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2">
                                                            <TextBlock Text="{Binding Name}" />
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="UnblockButton" Content="Unblock selected" Click="UnblockApps_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                                            <Button Content="Block from starting" Click="BlockApps_Click" Margin="0,0,8,0" />
                                            <Button Content="End task" Style="{StaticResource PrimaryButton}" Click="EndTask_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,14,4">
                                        <TextBlock DockPanel.Dock="Right" Text="GPU" Width="60" TextAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        <TextBlock DockPanel.Dock="Right" Text="MEMORY" Width="90" TextAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        <TextBlock DockPanel.Dock="Right" Text="CPU" Width="60" TextAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        <TextBlock x:Name="ProcessCountText" Text="APP" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                    </DockPanel>
                                    <ItemsControl x:Name="ProcessesList" Style="{StaticResource VirtualList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding GpuText}" Width="60" TextAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding RamText}" Width="90" TextAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CpuText}" Width="60" TextAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                                        <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    <Border Visibility="{Binding BadgeVisibility}" BorderBrush="{DynamicResource StatusWarn}" BorderThickness="1" CornerRadius="{DynamicResource PillRadius}" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{DynamicResource StatusWarn}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                            <Border x:Name="EventsPage" Visibility="Collapsed">
                                <DockPanel Margin="16">
                                    <Border DockPanel.Dock="Top" Padding="14,10" Margin="0,0,0,12" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CaseLabel}" Tag="Alerts — a notification in the tray, and an entry in this list" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <WrapPanel>
                                                <WrapPanel.Resources>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Setter Property="Width" Value="44" />
                                                        <Setter Property="Padding" Value="4,1" />
                                                        <Setter Property="Margin" Value="4,0" />
                                                        <Setter Property="TextAlignment" Value="Center" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                    </Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                    </Style>
                                                </WrapPanel.Resources>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,24,4">
                                                    <CheckBox x:Name="AlertCpuTempCheck" VerticalAlignment="Center" Click="AlertSetting_Changed" Content="CPU above" />
                                                    <TextBox x:Name="AlertCpuTempBox" TextChanged="AlertSetting_Changed" AutomationProperties.Name="CPU temperature limit, °C" />
                                                    <TextBlock Text="°C for 30 s" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,24,4">
                                                    <CheckBox x:Name="AlertGpuTempCheck" VerticalAlignment="Center" Click="AlertSetting_Changed" Content="GPU above" />
                                                    <TextBox x:Name="AlertGpuTempBox" TextChanged="AlertSetting_Changed" AutomationProperties.Name="GPU temperature limit, °C" />
                                                    <TextBlock Text="°C for 30 s" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,24,4">
                                                    <CheckBox x:Name="AlertMemCheck" VerticalAlignment="Center" Click="AlertSetting_Changed" Content="Memory above" />
                                                    <TextBox x:Name="AlertMemBox" TextChanged="AlertSetting_Changed" AutomationProperties.Name="Memory limit, percent" />
                                                    <TextBlock Text="% for 1 min" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,24,4">
                                                    <CheckBox x:Name="AlertAppCpuCheck" VerticalAlignment="Center" Click="AlertSetting_Changed" Content="An app above" />
                                                    <TextBox x:Name="AlertAppCpuBox" TextChanged="AlertSetting_Changed" AutomationProperties.Name="App CPU limit, percent" />
                                                    <TextBlock Text="% CPU for" />
                                                    <TextBox x:Name="AlertAppMinutesBox" TextChanged="AlertSetting_Changed" AutomationProperties.Name="App CPU duration, minutes" />
                                                    <TextBlock Text="min" />
                                                </StackPanel>
                                                <CheckBox x:Name="AlertUnsignedCheck" Margin="0,6,24,4" Click="AlertSetting_Changed" Content="An unsigned app starts" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <ComboBox x:Name="EventsRangeCombo" DockPanel.Dock="Left" Width="130" VerticalAlignment="Center" SelectionChanged="EventsRange_Changed" AutomationProperties.Name="Show events from">
                                            <ComboBoxItem Content="Last 24 hours" Tag="24" IsSelected="True" />
                                            <ComboBoxItem Content="Last 7 days" Tag="168" />
                                            <ComboBoxItem Content="Last 30 days" Tag="720" />
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource CaseLabel}" Tag="Search" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="16,0,8,0" />
                                        <TextBox x:Name="EventsFilterBox" Width="220" HorizontalAlignment="Left" VerticalAlignment="Center" TextChanged="EventsFilter_Changed" AutomationProperties.Name="Search events" />
                                    </DockPanel>
                                    <ItemsControl x:Name="EventsList" Style="{StaticResource VirtualList}" ItemTemplate="{StaticResource EventRowTemplate}" />
                                </DockPanel>
                            </Border>
                            <Border x:Name="PrivacyPage" Visibility="Collapsed">
                                <DockPanel Margin="16">
                                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"
                                               Text="Apps that used your camera, microphone or location, from the log Windows keeps for its privacy indicator. Updates every few seconds while this page is open." />
                                    <ItemsControl x:Name="PrivacyList" Style="{StaticResource VirtualList}" ItemTemplate="{StaticResource HistoryRowTemplate}" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="History">
                    <DockPanel Margin="16">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="HistoryRange1h" Content="1h" GroupName="HistoryRange" Tag="1" Style="{StaticResource PillToggle}" IsChecked="True" Checked="HistoryRange_Checked" />
                                <RadioButton Content="2h" GroupName="HistoryRange" Tag="2" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryRange_Checked" />
                                <RadioButton Content="3h" GroupName="HistoryRange" Tag="3" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryRange_Checked" />
                                <RadioButton Content="5h" GroupName="HistoryRange" Tag="5" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryRange_Checked" />
                                <RadioButton Content="24h" GroupName="HistoryRange" Tag="24" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryRange_Checked" />
                                <RadioButton Content="3d" GroupName="HistoryRange" Tag="72" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryRange_Checked" />
                                <RadioButton Content="7d" GroupName="HistoryRange" Tag="168" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryRange_Checked" />
                                <Button Content="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="HistoryPrev_Click" Margin="12,0,0,0" ToolTip="Earlier" AutomationProperties.Name="Earlier" />
                                <Button Content="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="HistoryNext_Click" Margin="6,0,0,0" ToolTip="Later" AutomationProperties.Name="Later" />
                                <Button Content="Now" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="HistoryNow_Click" Margin="6,0,0,0" />
                                <RadioButton x:Name="HistoryMetricCpu" Content="CPU" GroupName="HistoryMetric" Tag="cpu" Style="{StaticResource PillToggle}" IsChecked="True" Margin="16,0,0,0" Checked="HistoryMetric_Checked" />
                                <RadioButton Content="Memory" GroupName="HistoryMetric" Tag="mem" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryMetric_Checked" />
                                <RadioButton Content="GPU" GroupName="HistoryMetric" Tag="gpu" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryMetric_Checked" />
                                <RadioButton x:Name="HistoryMetricDisk" Content="Disk" GroupName="HistoryMetric" Tag="disk" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryMetric_Checked" />
                                <RadioButton x:Name="HistoryMetricNet" Content="Network" GroupName="HistoryMetric" Tag="net" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryMetric_Checked" />
                                <RadioButton x:Name="HistoryMetricPower" Content="Power" GroupName="HistoryMetric" Tag="power" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryMetric_Checked" ToolTip="CPU + GPU power draw, W" />
                                <RadioButton x:Name="HistoryMetricFan" Content="Fans" GroupName="HistoryMetric" Tag="fan" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryMetric_Checked" ToolTip="The fastest fan, RPM" />
                                <RadioButton x:Name="HistoryMetricBattery" Content="Battery" GroupName="HistoryMetric" Tag="battery" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryMetric_Checked" Visibility="Collapsed" />
                                <Button x:Name="HistoryAppChip" Visibility="Collapsed" Padding="10,4" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"
                                        Click="HistoryAppClear_Click" ToolTip="Back to the whole PC" />
                            </StackPanel>
                        </DockPanel>
                        <!-- Chart over the app lists, split by a bar that resizes the lists (the height is remembered) -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="220" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="HistoryListsRow" Height="160" MinHeight="70" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Bottom" Height="46" Margin="0,8,0,0">
                                    <ComboBox x:Name="NavigatorSpanCombo" DockPanel.Dock="Left" Width="110" VerticalAlignment="Center" SelectionChanged="NavigatorSpan_Changed" AutomationProperties.Name="Overview span">
                                        <ComboBoxItem Content="1 hour" Tag="1" />
                                        <ComboBoxItem Content="2 hours" Tag="2" />
                                        <ComboBoxItem Content="3 hours" Tag="3" />
                                        <ComboBoxItem Content="1 day" Tag="24" IsSelected="True" />
                                        <ComboBoxItem Content="3 days" Tag="72" />
                                        <ComboBoxItem Content="7 days" Tag="168" />
                                        <ComboBoxItem Content="30 days" Tag="720" />
                                        <ComboBoxItem Content="Everything" Tag="0" />
                                    </ComboBox>
                                    <Button DockPanel.Dock="Right" Content="Export…" Margin="8,0,0,0" VerticalAlignment="Center" Click="ExportHistory_Click" ToolTip="Save what the chart shows as CSV files (Excel opens them)" />
                                    <ComboBox x:Name="RetentionCombo" DockPanel.Dock="Right" Width="190" VerticalAlignment="Center" SelectionChanged="Retention_Changed" AutomationProperties.Name="Keep history for"
                                              ToolTip="How long the history is kept. About 1 MB per day; days past the limit are removed at midnight.">
                                        <ComboBoxItem Content="Keep 1 month (~30 MB)" Tag="30" />
                                        <ComboBoxItem Content="Keep 3 months (~90 MB)" Tag="90" />
                                        <ComboBoxItem Content="Keep 6 months (~180 MB)" Tag="180" />
                                        <ComboBoxItem Content="Keep 1 year (~370 MB)" Tag="365" />
                                    </ComboBox>
                                    <Border x:Name="HistoryNavigatorBorder" Margin="8,0" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                                        <Canvas x:Name="HistoryNavigator" Background="Transparent" Cursor="Hand" ToolTip="Drag to move through the history"
                                                MouseLeftButtonDown="Navigator_MouseDown" MouseMove="Navigator_MouseMove" MouseLeftButtonUp="Navigator_MouseUp" />
                                    </Border>
                                </DockPanel>
                                <Canvas x:Name="HistoryAxis" DockPanel.Dock="Bottom" Height="16" Margin="0,4,0,0" ClipToBounds="True" />
                                <Border x:Name="HistoryChartBorder" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <Canvas x:Name="HistoryChart" Background="Transparent" Cursor="Cross"
                                                MouseMove="HistoryChart_MouseMove" MouseLeave="HistoryChart_MouseLeave" MouseLeftButtonDown="HistoryChart_MouseDown" MouseLeftButtonUp="HistoryChart_MouseUp" MouseWheel="HistoryChart_MouseWheel"
                                                MouseRightButtonDown="HistoryChart_MouseRightDown" MouseRightButtonUp="HistoryChart_MouseRightUp" />
                                        <TextBlock x:Name="HistoryRangeText" Margin="12,0,0,56" HorizontalAlignment="Left" VerticalAlignment="Bottom" Foreground="{DynamicResource TextSecondary}" FontSize="11" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                            </DockPanel>
                            <GridSplitter Grid.Row="1" Height="12" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                          Cursor="SizeNS" ToolTip="Drag to resize" AutomationProperties.Name="Resize the app lists" DragCompleted="HistorySplitter_DragCompleted">
                                <GridSplitter.Template>
                                    <ControlTemplate TargetType="GridSplitter">
                                        <Border Background="Transparent">
                                            <Border Width="44" Height="4" CornerRadius="2" Background="{DynamicResource ScrollThumb}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </GridSplitter.Template>
                            </GridSplitter>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DockPanel>
                                    <TextBlock x:Name="HistoryCursorTitle" DockPanel.Dock="Top" Text="Hover to see what was running · click to pin a moment · drag across a stretch or scroll to zoom · click an app below to chart it · right-drag to move, right-click to clear" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" />
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="HistoryCursorList" ItemTemplate="{StaticResource HistoryAppRowTemplate}" />
                                    </ScrollViewer>
                                </DockPanel>
                                <DockPanel Grid.Column="2">
