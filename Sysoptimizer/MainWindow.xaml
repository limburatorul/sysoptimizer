<Window x:Class="Sysoptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sysoptimizer" Icon="app.ico" Height="916" Width="1055" MinHeight="916" MinWidth="1055"
        Background="Transparent" FontSize="13" FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <DataTemplate x:Key="HistoryRowTemplate">
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,5">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Surface}">
            <TabControl x:Name="Tabs">

                <TabItem Header="Resources">
                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                        <StackPanel Margin="16">
                            <Border x:Name="HealthCardBorder" Padding="20" Margin="0,0,0,16" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="2">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" x:Name="OptimizeNowButton" Content="Optimize now" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="OptimizeNow_Click" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="SYSTEM HEALTH" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="SemiBold" />
                                        <DockPanel>
                                            <TextBlock VerticalAlignment="Center">
                                                <Run x:Name="HealthScoreText" Text="—" FontSize="44" FontWeight="Bold" Typography.NumeralAlignment="Tabular" /><Run Text="/100" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                                            </TextBlock>
                                            <ItemsControl x:Name="HealthIssuesList" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Text="Show last" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <RadioButton Content="30s" GroupName="Duration" Tag="30" Style="{StaticResource PillToggle}" Checked="DurationPill_Checked" />
                                    <RadioButton Content="1m" GroupName="Duration" Tag="60" Style="{StaticResource PillToggle}" IsChecked="True" Margin="6,0,0,0" Checked="DurationPill_Checked" />
                                    <RadioButton Content="2m" GroupName="Duration" Tag="120" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="DurationPill_Checked" />
                                    <RadioButton Content="5m" GroupName="Duration" Tag="300" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="DurationPill_Checked" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel>
                                <Border x:Name="CpuCardBorder" Height="150" Margin="0,0,0,10" Padding="0,14,0,0" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                                    <Grid x:Name="CpuGraphGrid">
                                        <Path x:Name="CpuAreaFill" Fill="{DynamicResource AreaFillCpu}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        <Path x:Name="CpuSparkline" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource AccentCpu}" StrokeThickness="{DynamicResource GraphStroke}"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Effect="{DynamicResource LineGlowCpu}" />
                                        <StackPanel VerticalAlignment="Top" Margin="14,0">
                                            <TextBlock Text="CPU" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                            <TextBlock x:Name="CpuPercentText" Text="0%" FontSize="26" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock x:Name="CpuDetailText" Text="" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        </StackPanel>
                                        <CheckBox x:Name="CpuPerThreadCheck" Content="Per thread" Style="{StaticResource PillToggle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,14,0"
                                                  Checked="CpuPerThread_Changed" Unchecked="CpuPerThread_Changed" />
                                        <UniformGrid x:Name="CpuThreadsGrid" Visibility="Collapsed" Margin="11,56,11,11" />
                                    </Grid>
                                </Border>
                                <Border x:Name="MemCardBorder" Height="150" Margin="0,0,0,10" Padding="0,14,0,0" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                                    <Grid x:Name="MemGraphGrid">
                                        <Path x:Name="MemAreaFill" Fill="{DynamicResource AreaFillMem}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        <Path x:Name="MemSparkline" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource AccentMem}" StrokeThickness="{DynamicResource GraphStroke}"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Effect="{DynamicResource LineGlowMem}" />
                                        <StackPanel VerticalAlignment="Top" Margin="14,0">
                                            <TextBlock Text="MEMORY" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                            <TextBlock x:Name="MemPercentText" Text="0%" FontSize="26" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock x:Name="MemDetailText" Text="0 / 0 GB" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        </StackPanel>
                                        <Button Content="Free memory" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,14,0" Padding="10,3" FontSize="11" Click="TrimMemory_Click"
                                                ToolTip="Trims every process's working set: its pages move to standby or the pagefile, and free RAM rises right away. Apps read back what they use next, so they can feel slower for a moment. It doesn't make Windows faster in general." />
                                    </Grid>
                                </Border>
                                <Border x:Name="GpuCardBorder" Height="150" Padding="0,14,0,0" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                                    <Grid x:Name="GpuGraphGrid">
                                        <Path x:Name="GpuAreaFill" Fill="{DynamicResource AreaFillGpu}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        <Path x:Name="GpuSparkline" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource AccentGpu}" StrokeThickness="{DynamicResource GraphStroke}"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Effect="{DynamicResource LineGlowGpu}" />
                                        <StackPanel VerticalAlignment="Top" Margin="14,0">
                                            <TextBlock Text="GPU" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                            <TextBlock x:Name="GpuPercentText" Text="—" FontSize="26" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock x:Name="GpuDetailText" Text="Not available" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Processes">
                    <DockPanel Margin="16">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="Sort by" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                                <RadioButton Content="CPU" GroupName="ProcessSort" Tag="cpu" Style="{StaticResource PillToggle}" IsChecked="True" Checked="ProcessSort_Checked" />
                                <RadioButton Content="Memory" GroupName="ProcessSort" Tag="ram" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="ProcessSort_Checked" />
                                <RadioButton Content="GPU" GroupName="ProcessSort" Tag="gpu" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="ProcessSort_Checked" />
                            </StackPanel>
                            <TextBlock Text="Filter" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                            <TextBox x:Name="ProcessFilterBox" Width="220" HorizontalAlignment="Left" VerticalContentAlignment="Center" TextChanged="ProcessFilter_Changed" />
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <StackPanel x:Name="BlockedPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                <TextBlock Text="BLOCKED APPS" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ItemsControl x:Name="BlockedList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2">
                                                <TextBlock Text="{Binding Name}" />
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="UnblockButton" Content="Unblock selected" Click="UnblockApps_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                                <Button Content="Block from starting" Click="BlockApps_Click" Margin="0,0,8,0" />
                                <Button Content="End task" Style="{StaticResource PrimaryButton}" Click="EndTask_Click" />
                            </StackPanel>
                        </StackPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,14,4">
                            <TextBlock DockPanel.Dock="Right" Text="GPU" Width="60" TextAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                            <TextBlock DockPanel.Dock="Right" Text="MEMORY" Width="90" TextAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                            <TextBlock DockPanel.Dock="Right" Text="CPU" Width="60" TextAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                            <TextBlock x:Name="ProcessCountText" Text="APP" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                        </DockPanel>
                        <ItemsControl x:Name="ProcessesList" Style="{StaticResource VirtualList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding GpuText}" Width="60" TextAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RamText}" Width="90" TextAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CpuText}" Width="60" TextAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                            <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </DockPanel>
                </TabItem>

                <TabItem Header="History">
                    <DockPanel Margin="16">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="HistoryRange1h" Content="1h" GroupName="HistoryRange" Tag="1" Style="{StaticResource PillToggle}" IsChecked="True" Checked="HistoryRange_Checked" />
                                <RadioButton Content="2h" GroupName="HistoryRange" Tag="2" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryRange_Checked" />
                                <RadioButton Content="3h" GroupName="HistoryRange" Tag="3" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryRange_Checked" />
                                <RadioButton Content="5h" GroupName="HistoryRange" Tag="5" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryRange_Checked" />
                                <RadioButton Content="24h" GroupName="HistoryRange" Tag="24" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryRange_Checked" />
                                <RadioButton Content="3d" GroupName="HistoryRange" Tag="72" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryRange_Checked" />
                                <RadioButton Content="7d" GroupName="HistoryRange" Tag="168" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryRange_Checked" />
                                <Button Content="◀" Click="HistoryPrev_Click" Margin="12,0,0,0" ToolTip="Earlier" AutomationProperties.Name="Earlier" />
                                <Button Content="▶" Click="HistoryNext_Click" Margin="6,0,0,0" ToolTip="Later" AutomationProperties.Name="Later" />
                                <Button Content="Now" Click="HistoryNow_Click" Margin="6,0,0,0" />
                                <RadioButton Content="CPU" GroupName="HistoryMetric" Tag="cpu" Style="{StaticResource PillToggle}" IsChecked="True" Margin="16,0,0,0" Checked="HistoryMetric_Checked" />
                                <RadioButton Content="Memory" GroupName="HistoryMetric" Tag="mem" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryMetric_Checked" />
                                <RadioButton Content="GPU" GroupName="HistoryMetric" Tag="gpu" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryMetric_Checked" />
                            </StackPanel>
                            <CheckBox x:Name="BackgroundCheck" Content="Record in background" Style="{StaticResource PillToggle}" Click="BackgroundCheck_Click" HorizontalAlignment="Right"
                                      ToolTip="Start with Windows, hidden in the tray, so the history has no gaps" />
                        </DockPanel>
                        <Grid DockPanel.Dock="Bottom" Height="160" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <TextBlock x:Name="HistoryCursorTitle" DockPanel.Dock="Top" Text="Hover to see what was running · click to pin a moment · drag across a stretch or scroll to zoom · right-drag to move" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                                <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                    <ItemsControl x:Name="HistoryCursorList" ItemTemplate="{StaticResource HistoryRowTemplate}" />
                                </ScrollViewer>
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <TextBlock x:Name="HistoryRangeTitle" DockPanel.Dock="Top" Text="TOP APPS IN THIS RANGE" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                    <ItemsControl x:Name="HistoryRangeList" ItemTemplate="{StaticResource HistoryRowTemplate}" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                        <DockPanel DockPanel.Dock="Bottom" Height="46" Margin="0,8,0,0">
                            <ComboBox x:Name="NavigatorSpanCombo" DockPanel.Dock="Left" Width="110" VerticalAlignment="Center" SelectionChanged="NavigatorSpan_Changed" AutomationProperties.Name="Overview span">
                                <ComboBoxItem Content="1 hour" Tag="1" />
                                <ComboBoxItem Content="2 hours" Tag="2" />
                                <ComboBoxItem Content="3 hours" Tag="3" />
                                <ComboBoxItem Content="1 day" Tag="24" IsSelected="True" />
                                <ComboBoxItem Content="3 days" Tag="72" />
                                <ComboBoxItem Content="7 days" Tag="168" />
                                <ComboBoxItem Content="30 days" Tag="720" />
                                <ComboBoxItem Content="Everything" Tag="0" />
                            </ComboBox>
                            <ComboBox x:Name="RetentionCombo" DockPanel.Dock="Right" Width="190" VerticalAlignment="Center" SelectionChanged="Retention_Changed" AutomationProperties.Name="Keep history for"
                                      ToolTip="How long the history is kept. About 1 MB per day; days past the limit are removed at midnight.">
                                <ComboBoxItem Content="Keep 1 month (~30 MB)" Tag="30" />
                                <ComboBoxItem Content="Keep 3 months (~90 MB)" Tag="90" />
                                <ComboBoxItem Content="Keep 6 months (~180 MB)" Tag="180" />
                                <ComboBoxItem Content="Keep 1 year (~370 MB)" Tag="365" />
                            </ComboBox>
                            <Border Margin="8,0" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                                <Canvas x:Name="HistoryNavigator" Background="Transparent" Cursor="Hand" ToolTip="Drag to move through the history"
                                        MouseLeftButtonDown="Navigator_MouseDown" MouseMove="Navigator_MouseMove" MouseLeftButtonUp="Navigator_MouseUp" />
                            </Border>
                        </DockPanel>
                        <Canvas x:Name="HistoryAxis" DockPanel.Dock="Bottom" Height="16" Margin="0,4,0,0" ClipToBounds="True" />
                        <Border CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Canvas x:Name="HistoryChart" Background="Transparent" Cursor="Cross"
                                        MouseMove="HistoryChart_MouseMove" MouseLeave="HistoryChart_MouseLeave" MouseLeftButtonDown="HistoryChart_MouseDown" MouseLeftButtonUp="HistoryChart_MouseUp" MouseWheel="HistoryChart_MouseWheel"
                                        MouseRightButtonDown="HistoryChart_MouseRightDown" MouseRightButtonUp="HistoryChart_MouseRightUp" />
                                <TextBlock x:Name="HistoryRangeText" Margin="12,0,0,56" HorizontalAlignment="Left" VerticalAlignment="Bottom" Foreground="{DynamicResource TextSecondary}" FontSize="11" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Disks">
                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                        <ItemsControl x:Name="DiskCardsHost" Margin="16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Network">
                    <DockPanel Margin="16">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="DNS" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,8" />
                            <DockPanel>
                                <ComboBox x:Name="DnsAdapterCombo" DockPanel.Dock="Left" Width="200" Margin="0,0,10,0" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Automatic" Tag="0" Click="SetDns_Click" Margin="0,0,6,0" />
                                    <Button Content="Cloudflare" Tag="1" Click="SetDns_Click" Margin="0,0,6,0" />
                                    <Button Content="Google" Tag="2" Click="SetDns_Click" Margin="0,0,6,0" />
                                    <Button Content="Quad9" Tag="3" Click="SetDns_Click" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                        <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                            <ItemsControl x:Name="NetCardsHost">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Optimize">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,14,16,0">
                            <RadioButton Content="Cleanup" GroupName="OptimizePages" Tag="{Binding ElementName=CleanupPage}" Style="{StaticResource PillToggle}" IsChecked="True" Checked="SubPage_Checked" />
                            <RadioButton Content="Tweaks" GroupName="OptimizePages" Tag="{Binding ElementName=TweaksPage}" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="SubPage_Checked" />
                            <RadioButton Content="Debloat" GroupName="OptimizePages" Tag="{Binding ElementName=DebloatPage}" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="SubPage_Checked" />
                            <RadioButton Content="Uninstall" GroupName="OptimizePages" Tag="{Binding ElementName=UninstallPage}" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="SubPage_Checked" />
                        </StackPanel>
                        <Grid>
                            <Border x:Name="CleanupPage">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Analyze" Click="AnalyzeCleanup_Click" Margin="0,0,8,0" />
                                        <Button Content="Clean selected" Style="{StaticResource PrimaryButton}" Click="Clean_Click" />
                                    </StackPanel>
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="CleanupList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource TextSecondary}"
                                                                       VerticalAlignment="Top" Typography.NumeralAlignment="Tabular" />
                                                            <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border x:Name="TweaksPage" Visibility="Collapsed">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Create restore point" Click="CreateRestorePoint_Click" Margin="0,0,8,0" />
                                        <Button Content="Restart Explorer" Click="RestartExplorer_Click" Margin="0,0,16,0" />
                                        <Button Content="Export..." Click="ExportTweaks_Click" Margin="0,0,8,0" />
                                        <Button Content="Import..." Click="ImportTweaks_Click" Margin="0,0,16,0" />
                                        <Button Content="Revert selected" Click="RevertTweaks_Click" Margin="0,0,8,0" />
                                        <Button Content="Apply selected" Style="{StaticResource PrimaryButton}" Click="ApplyTweaks_Click" />
                                    </StackPanel>
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="TweaksList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" FontSize="11" />
                                                            <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border x:Name="DebloatPage" Visibility="Collapsed">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Remove selected" Style="{StaticResource PrimaryButton}" Click="RemoveBloatware_Click" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                               Text="Pre-installed apps most people never open. Removing one affects this PC only; most can be reinstalled from the Microsoft Store." />
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="BloatwareList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}"
                                                            Padding="10" Margin="0,0,10,10" Width="220">
                                                        <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Note}" Foreground="{DynamicResource TextSecondary}" FontSize="10" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border x:Name="UninstallPage" Visibility="Collapsed">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                        <ItemsControl x:Name="LeftoversList" Margin="0,0,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                                        <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="DeleteLeftoversButton" Content="Delete leftover folders" Click="DeleteLeftovers_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                                            <Button Content="Uninstall selected" Style="{StaticResource PrimaryButton}" Click="UninstallApps_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="InstalledAppsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" />
                                                            <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Files">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,14,16,0">
                            <RadioButton Content="Duplicates" GroupName="FilesPages" Tag="{Binding ElementName=DuplicatesPage}" Style="{StaticResource PillToggle}" IsChecked="True" Checked="SubPage_Checked" />
                            <RadioButton Content="Large files" GroupName="FilesPages" Tag="{Binding ElementName=LargeFilesPage}" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="SubPage_Checked" />
                        </StackPanel>
                        <Grid>
                            <Border x:Name="DuplicatesPage">
                                <DockPanel Margin="16">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Content="Scan" Click="ScanDuplicates_Click" Margin="8,0,0,0" />
                                        <TextBox x:Name="DuplicatesFolderBox" DockPanel.Dock="Right" Width="260" Margin="8,0,0,0" VerticalContentAlignment="Center" />
                                        <Button Content="Browse..." Click="BrowseDuplicatesFolder_Click" HorizontalAlignment="Left" />
                                    </DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Delete selected" Style="{StaticResource PrimaryButton}" Click="DeleteDuplicates_Click" />
                                    </StackPanel>
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="DuplicatesList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                            <ItemsControl ItemsSource="{Binding Files}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <DockPanel Margin="0,2">
                                                                            <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                                                <TextBlock Text="{Binding Description}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                            </CheckBox>
                                                                        </DockPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border x:Name="LargeFilesPage" Visibility="Collapsed">
                                <DockPanel Margin="16">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Content="Scan" Click="ScanLargeFiles_Click" Margin="8,0,0,0" />
                                        <TextBox x:Name="LargeFilesFolderBox" DockPanel.Dock="Right" Width="260" Margin="8,0,0,0" VerticalContentAlignment="Center" />
                                        <Button Content="Browse..." Click="BrowseLargeFilesFolder_Click" HorizontalAlignment="Left" />
                                    </DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Delete selected" Style="{StaticResource PrimaryButton}" Click="DeleteLargeFiles_Click" />
                                    </StackPanel>
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="LargeFilesList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" Typography.NumeralAlignment="Tabular" />
                                                            <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Startup">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,14,16,0">
                            <RadioButton Content="Startup apps" GroupName="StartupPages" Tag="{Binding ElementName=StartupPage}" Style="{StaticResource PillToggle}" IsChecked="True" Checked="SubPage_Checked" />
                            <RadioButton Content="Services" GroupName="StartupPages" Tag="{Binding ElementName=ServicesPage}" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="SubPage_Checked" />
                        </StackPanel>
                        <Grid>
                            <Border x:Name="StartupPage">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Enable selected" Click="EnableStartup_Click" Margin="0,0,8,0" />
                                        <Button Content="Disable selected" Style="{StaticResource PrimaryButton}" Click="DisableStartup_Click" />
                                    </StackPanel>
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="StartupList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" />
                                                            <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border x:Name="ServicesPage" Visibility="Collapsed">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Re-enable selected" Click="EnableServices_Click" Margin="0,0,8,0" />
                                        <Button Content="Stop and disable selected" Style="{StaticResource PrimaryButton}" Click="DisableServices_Click" />
                                    </StackPanel>
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="ServicesList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" />
                                                            <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Apps">
                    <DockPanel Margin="16">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Update all (winget)" Click="UpgradeAll_Click" Margin="0,0,8,0" />
                            <Button Content="Install selected" Style="{StaticResource PrimaryButton}" Click="InstallApps_Click" />
                        </StackPanel>
                        <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                            <ItemsControl x:Name="AppsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}"
                                                Padding="10" Margin="0,0,10,10" Width="220">
                                            <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Privacy">
                    <DockPanel Margin="16">
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"
                                   Text="Apps that used your camera, microphone or location, from the log Windows keeps for its privacy indicator. Updates every few seconds while this tab is open." />
                        <ItemsControl x:Name="PrivacyList" Style="{StaticResource VirtualList}" ItemTemplate="{StaticResource HistoryRowTemplate}" />
                    </DockPanel>
                </TabItem>

                <TabItem Header="About">
                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                        <StackPanel Margin="16" MaxWidth="640" HorizontalAlignment="Left">
                            <StackPanel.Resources>
                                <Style TargetType="Hyperlink"><Setter Property="Foreground" Value="{DynamicResource Accent}" /></Style>
                            </StackPanel.Resources>
                            <TextBlock Text="Sysoptimizer" FontSize="28" FontWeight="Bold" />
                            <TextBlock x:Name="AboutVersionText" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,6" />
                            <TextBlock Text="Watches, records and tidies up your PC — by Protagonist Labs." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,20" />

                            <Border Padding="18,6" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel.Resources>
                                        <Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Border}" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="Padding" Value="0,10" /></Style>
                                    </StackPanel.Resources>
                                    <Border>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Hyperlink x:Name="CheckUpdatesLink" Click="CheckUpdatesLink_Click">Check for updates</Hyperlink></TextBlock>
                                            <TextBlock Text="Sysoptimizer also checks on its own and offers new versions as they come out." Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Hyperlink Click="ConnectClaude_Click">Connect to Claude</Hyperlink></TextBlock>
                                            <TextBlock Text="Lets Claude read your recorded history and answer questions like &quot;what slowed my PC down yesterday?&quot;" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Hyperlink NavigateUri="mailto:feedback@protagonistlabs.app?subject=Sysoptimizer%20feedback" RequestNavigate="Link_Navigate">Send feedback</Hyperlink></TextBlock>
                                            <TextBlock Text="feedback@protagonistlabs.app — bugs, ideas, anything." Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Hyperlink NavigateUri="https://protagonistlabs.app/sysoptimizer/?utm_source=sysoptimizer&amp;utm_medium=app&amp;utm_campaign=about" RequestNavigate="Link_Navigate">Website</Hyperlink></TextBlock>
                                            <TextBlock Text="protagonistlabs.app/sysoptimizer" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <Border BorderThickness="0">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Hyperlink NavigateUri="https://protagonistlabs.app/?utm_source=sysoptimizer&amp;utm_medium=app&amp;utm_campaign=more-apps" RequestNavigate="Link_Navigate">More apps from Protagonist Labs</Hyperlink></TextBlock>
                                            <TextBlock Text="protagonistlabs.app" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,10">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Log" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="Theme" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="24,0,8,0" />
                        <RadioButton x:Name="ThemeGlass" Content="Glass" GroupName="Theme" Tag="Glass" Style="{StaticResource PillToggle}" Checked="Theme_Checked" />
                        <RadioButton x:Name="ThemeStarTrek" Content="Star Trek" GroupName="Theme" Tag="StarTrek" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="Theme_Checked" />
                        <RadioButton x:Name="ThemeStarCraft" Content="StarCraft" GroupName="Theme" Tag="StarCraft" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="Theme_Checked" />
                        <RadioButton x:Name="ThemeCyberpunk" Content="Cyberpunk" GroupName="Theme" Tag="Cyberpunk" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="Theme_Checked" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer Style="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource LogForeground}" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
