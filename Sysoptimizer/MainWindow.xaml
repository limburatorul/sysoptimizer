<Window x:Class="Sysoptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sysoptimizer" Icon="app.ico" Height="916" Width="1055" MinHeight="916" MinWidth="1055"
        Background="Transparent" FontSize="13" FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate x:Key="HistoryRowTemplate">
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,5">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
        <!-- An event: clicking it (mouse or keyboard) opens History at that moment, pinned -->
        <DataTemplate x:Key="EventRowTemplate">
            <Button Click="EventRow_Click" Cursor="Hand" ToolTip="Show this moment in History" AutomationProperties.Name="{Binding Name}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HistoryRowTemplate}" />
            </Button>
        </DataTemplate>
        <!-- The same row, clickable (mouse or keyboard): charts that app in History -->
        <DataTemplate x:Key="HistoryAppRowTemplate">
            <Button Click="HistoryApp_Click" Cursor="Hand" ToolTip="Click to chart this app over time" AutomationProperties.Name="{Binding Name}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HistoryRowTemplate}" />
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Surface}">
            <TabControl x:Name="Tabs">

                <TabItem Header="Resources">
                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                        <StackPanel Margin="16">
                            <StackPanel x:Name="WatchedPcsPanel" Visibility="Collapsed" Margin="0,0,0,16">
                                <DockPanel Margin="0,0,10,6">
                                    <Button x:Name="AllPcsButton" DockPanel.Dock="Right" Content="All PCs ⋯" Click="PcActions_Click" Padding="10,2" FontSize="11" Visibility="Collapsed"
                                            ToolTip="Update apps, clean up, send files, restart or shut down every watched PC at once" />
                                    <TextBlock Style="{StaticResource CaseLabel}" Tag="Watched PCs" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl x:Name="WatchedPcsList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Card" Width="345" Padding="14,10" Margin="0,0,10,10" AllowDrop="True" Drop="PcCard_Drop" DragOver="PcCard_DragOver" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Button x:Name="ShowButton" Content="Show" Tag="{Binding}" Click="PcShow_Click" Margin="6,0,0,0" AutomationProperties.Name="{Binding Name, StringFormat=Show {0} in every tab}" />
                                                        <Button Content="⋯" Tag="{Binding}" Click="PcActions_Click" Margin="6,0,0,0" ToolTip="Update apps, clean up, send files, restart or shut down" AutomationProperties.Name="{Binding Name, StringFormat=Actions on {0}}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock>
                                                            <Run x:Name="Dot" Text="● " Foreground="{DynamicResource StatusBad}" /><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Version, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Online}" Value="True">
                                                    <Setter TargetName="Dot" Property="Foreground" Value="{DynamicResource StatusGood}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Shown}" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                    <Setter TargetName="ShowButton" Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Border x:Name="HealthCardBorder" Padding="20" Margin="0,0,0,16" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" x:Name="OptimizeNowButton" Content="Optimize now" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="OptimizeNow_Click" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="SYSTEM HEALTH" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="SemiBold" />
                                        <DockPanel>
                                            <TextBlock VerticalAlignment="Center">
                                                <Run x:Name="HealthScoreText" Text="—" FontSize="44" FontWeight="Bold" Typography.NumeralAlignment="Tabular" /><Run Text="/100" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                                            </TextBlock>
                                            <ItemsControl x:Name="HealthIssuesList" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource CaseLabel}" Tag="Show last" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <RadioButton Content="30s" GroupName="Duration" Tag="30" Style="{StaticResource PillToggle}" Checked="DurationPill_Checked" />
                                    <RadioButton Content="1m" GroupName="Duration" Tag="60" Style="{StaticResource PillToggle}" IsChecked="True" Margin="6,0,0,0" Checked="DurationPill_Checked" />
                                    <RadioButton Content="2m" GroupName="Duration" Tag="120" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="DurationPill_Checked" />
                                    <RadioButton Content="5m" GroupName="Duration" Tag="300" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="DurationPill_Checked" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel>
                                <Border x:Name="CpuCardBorder" Height="150" Margin="0,0,0,10" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                                    <Grid x:Name="CpuGraphGrid">
                                        <Path x:Name="CpuAreaFill" Fill="{DynamicResource AreaFillCpu}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        <Path x:Name="CpuSparkline" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource AccentCpu}" StrokeThickness="{DynamicResource GraphStroke}"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Effect="{DynamicResource LineGlowCpu}" />
                                        <StackPanel VerticalAlignment="Top" Margin="14,14,14,0">
                                            <TextBlock Text="CPU" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                            <TextBlock x:Name="CpuPercentText" Text="0%" FontSize="26" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock x:Name="CpuDetailText" Text="" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        </StackPanel>
                                        <CheckBox x:Name="CpuPerThreadCheck" Content="Per thread" Style="{StaticResource PillToggle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                                                  Checked="CpuPerThread_Changed" Unchecked="CpuPerThread_Changed" />
                                        <UniformGrid x:Name="CpuThreadsGrid" Visibility="Collapsed" Margin="11,70,11,11" />
                                    </Grid>
                                </Border>
                                <Border x:Name="MemCardBorder" Height="150" Margin="0,0,0,10" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                                    <Grid x:Name="MemGraphGrid">
                                        <Path x:Name="MemAreaFill" Fill="{DynamicResource AreaFillMem}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        <Path x:Name="MemSparkline" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource AccentMem}" StrokeThickness="{DynamicResource GraphStroke}"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Effect="{DynamicResource LineGlowMem}" />
                                        <StackPanel VerticalAlignment="Top" Margin="14,14,14,0">
                                            <TextBlock Text="MEMORY" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                            <TextBlock x:Name="MemPercentText" Text="0%" FontSize="26" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock x:Name="MemDetailText" Text="0 / 0 GB" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        </StackPanel>
                                        <Button x:Name="FreeMemoryButton" Content="Free memory" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" Padding="10,3" FontSize="11" Click="TrimMemory_Click"
                                                ToolTip="Trims every process's working set: its pages move to standby or the pagefile, and free RAM rises right away. Apps read back what they use next, so they can feel slower for a moment. It doesn't make Windows faster in general." />
                                    </Grid>
                                </Border>
                                <Border x:Name="GpuCardBorder" Height="150" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                                    <Grid x:Name="GpuGraphGrid">
                                        <Path x:Name="GpuAreaFill" Fill="{DynamicResource AreaFillGpu}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        <Path x:Name="GpuSparkline" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource AccentGpu}" StrokeThickness="{DynamicResource GraphStroke}"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Effect="{DynamicResource LineGlowGpu}" />
                                        <StackPanel VerticalAlignment="Top" Margin="14,14,14,0">
                                            <TextBlock Text="GPU" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                            <TextBlock x:Name="GpuPercentText" Text="—" FontSize="26" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock x:Name="GpuDetailText" Text="Not available" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Padding="14,12" Margin="0,10,0,0" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CaseLabel}" Tag="Power &amp; cooling" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        <TextBlock x:Name="PowerText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock x:Name="FansText" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock x:Name="BatteryText" Visibility="Collapsed" FontSize="13" Margin="0,6,0,0" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Processes">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,14,16,0">
                            <RadioButton Content="Running" GroupName="ProcessesPages" Tag="{Binding ElementName=RunningPage}" Style="{StaticResource PillToggle}" IsChecked="True" Checked="SubPage_Checked" />
                            <RadioButton Content="Events" GroupName="ProcessesPages" Tag="{Binding ElementName=EventsPage}" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="SubPage_Checked" />
                            <RadioButton Content="Privacy" GroupName="ProcessesPages" Tag="{Binding ElementName=PrivacyPage}" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="SubPage_Checked" />
                        </StackPanel>
                        <Grid>
                            <Border x:Name="RunningPage">
                                <DockPanel Margin="16">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource CaseLabel}" Tag="Sort by" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                                            <RadioButton Content="CPU" GroupName="ProcessSort" Tag="cpu" Style="{StaticResource PillToggle}" IsChecked="True" Checked="ProcessSort_Checked" />
                                            <RadioButton Content="Memory" GroupName="ProcessSort" Tag="ram" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="ProcessSort_Checked" />
                                            <RadioButton Content="GPU" GroupName="ProcessSort" Tag="gpu" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="ProcessSort_Checked" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource CaseLabel}" Tag="Filter" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                                        <TextBox x:Name="ProcessFilterBox" Width="220" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center" TextChanged="ProcessFilter_Changed" />
                                    </DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                        <StackPanel x:Name="BlockedPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                            <TextBlock Text="BLOCKED APPS" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <ItemsControl x:Name="BlockedList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2">
                                                            <TextBlock Text="{Binding Name}" />
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="UnblockButton" Content="Unblock selected" Click="UnblockApps_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                                            <Button x:Name="BlockAppsButton" Content="Block from starting" Click="BlockApps_Click" Margin="0,0,8,0" />
                                            <Button Content="End task" Style="{StaticResource PrimaryButton}" Click="EndTask_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,14,4">
                                        <TextBlock DockPanel.Dock="Right" Text="GPU" Width="60" TextAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        <TextBlock DockPanel.Dock="Right" Text="MEMORY" Width="90" TextAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        <TextBlock DockPanel.Dock="Right" Text="CPU" Width="60" TextAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        <TextBlock x:Name="ProcessCountText" Text="APP" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                    </DockPanel>
                                    <ItemsControl x:Name="ProcessesList" Style="{StaticResource VirtualList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding GpuText}" Width="60" TextAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding RamText}" Width="90" TextAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CpuText}" Width="60" TextAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                                        <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    <Border Visibility="{Binding BadgeVisibility}" BorderBrush="{DynamicResource StatusWarn}" BorderThickness="1" CornerRadius="{DynamicResource PillRadius}" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{DynamicResource StatusWarn}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                            <Border x:Name="EventsPage" Visibility="Collapsed">
                                <DockPanel Margin="16">
                                    <Border DockPanel.Dock="Top" Padding="14,10" Margin="0,0,0,12" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CaseLabel}" Tag="Alerts — a notification in the tray, and an entry in this list" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <WrapPanel>
                                                <WrapPanel.Resources>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Setter Property="Width" Value="44" />
                                                        <Setter Property="Padding" Value="4,1" />
                                                        <Setter Property="Margin" Value="4,0" />
                                                        <Setter Property="TextAlignment" Value="Center" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                    </Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                    </Style>
                                                </WrapPanel.Resources>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,24,4">
                                                    <CheckBox x:Name="AlertCpuTempCheck" VerticalAlignment="Center" Click="AlertSetting_Changed" Content="CPU above" />
                                                    <TextBox x:Name="AlertCpuTempBox" TextChanged="AlertSetting_Changed" AutomationProperties.Name="CPU temperature limit, °C" />
                                                    <TextBlock Text="°C for 30 s" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,24,4">
                                                    <CheckBox x:Name="AlertGpuTempCheck" VerticalAlignment="Center" Click="AlertSetting_Changed" Content="GPU above" />
                                                    <TextBox x:Name="AlertGpuTempBox" TextChanged="AlertSetting_Changed" AutomationProperties.Name="GPU temperature limit, °C" />
                                                    <TextBlock Text="°C for 30 s" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,24,4">
                                                    <CheckBox x:Name="AlertMemCheck" VerticalAlignment="Center" Click="AlertSetting_Changed" Content="Memory above" />
                                                    <TextBox x:Name="AlertMemBox" TextChanged="AlertSetting_Changed" AutomationProperties.Name="Memory limit, percent" />
                                                    <TextBlock Text="% for 1 min" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,24,4">
                                                    <CheckBox x:Name="AlertAppCpuCheck" VerticalAlignment="Center" Click="AlertSetting_Changed" Content="An app above" />
                                                    <TextBox x:Name="AlertAppCpuBox" TextChanged="AlertSetting_Changed" AutomationProperties.Name="App CPU limit, percent" />
                                                    <TextBlock Text="% CPU for" />
                                                    <TextBox x:Name="AlertAppMinutesBox" TextChanged="AlertSetting_Changed" AutomationProperties.Name="App CPU duration, minutes" />
                                                    <TextBlock Text="min" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,24,4">
                                                    <CheckBox x:Name="AlertAppMemCheck" VerticalAlignment="Center" Click="AlertSetting_Changed" Content="An app using over" />
                                                    <TextBox x:Name="AlertAppMemBox" TextChanged="AlertSetting_Changed" AutomationProperties.Name="App memory limit, GB" />
                                                    <TextBlock Text="GB for 1 min" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,24,4">
                                                    <CheckBox x:Name="AlertDiskCheck" VerticalAlignment="Center" Click="AlertSetting_Changed" Content="A disk under" />
                                                    <TextBox x:Name="AlertDiskBox" TextChanged="AlertSetting_Changed" AutomationProperties.Name="Disk free space limit, percent" />
                                                    <TextBlock Text="% free" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,24,4">
                                                    <CheckBox x:Name="AlertBatteryCheck" VerticalAlignment="Center" Click="AlertSetting_Changed" Content="Battery under" />
                                                    <TextBox x:Name="AlertBatteryBox" TextChanged="AlertSetting_Changed" AutomationProperties.Name="Battery limit, percent" />
                                                    <TextBlock Text="% unplugged" />
                                                </StackPanel>
                                                <CheckBox x:Name="AlertUnsignedCheck" Margin="0,6,24,4" Click="AlertSetting_Changed" Content="An unsigned app starts" />
                                                <CheckBox x:Name="AlertDriveCheck" Margin="0,6,24,4" Click="AlertSetting_Changed" Content="A drive is failing or wearing out"
                                                          ToolTip="Windows or the drive itself reports a problem, an SSD has 10% of its life left or less, or a drive runs past its own warning temperature" />
                                                <CheckBox x:Name="AlertCoolingCheck" Margin="0,6,24,4" Click="AlertSetting_Changed" Content="Cooling got worse"
                                                          ToolTip="Once a day: if the CPU or GPU runs 7 °C or more hotter than a month ago at the same light load — dust, or a slowing fan" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <ComboBox x:Name="EventsRangeCombo" DockPanel.Dock="Left" Width="130" VerticalAlignment="Center" SelectionChanged="EventsRange_Changed" AutomationProperties.Name="Show events from">
                                            <ComboBoxItem Content="Last 24 hours" Tag="24" IsSelected="True" />
                                            <ComboBoxItem Content="Last 7 days" Tag="168" />
                                            <ComboBoxItem Content="Last 30 days" Tag="720" />
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource CaseLabel}" Tag="Search" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="16,0,8,0" />
                                        <TextBox x:Name="EventsFilterBox" Width="220" HorizontalAlignment="Left" VerticalAlignment="Center" TextChanged="EventsFilter_Changed" AutomationProperties.Name="Search events" />
                                    </DockPanel>
                                    <ItemsControl x:Name="EventsList" Style="{StaticResource VirtualList}" ItemTemplate="{StaticResource EventRowTemplate}" />
                                </DockPanel>
                            </Border>
                            <Border x:Name="PrivacyPage" Visibility="Collapsed">
                                <DockPanel Margin="16">
                                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"
                                               Text="Apps that used your camera, microphone or location, from the log Windows keeps for its privacy indicator. Updates every few seconds while this page is open." />
                                    <ItemsControl x:Name="PrivacyList" Style="{StaticResource VirtualList}" ItemTemplate="{StaticResource HistoryRowTemplate}" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="History">
                    <DockPanel Margin="16">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="HistoryRange1h" Content="1h" GroupName="HistoryRange" Tag="1" Style="{StaticResource PillToggle}" IsChecked="True" Checked="HistoryRange_Checked" />
                                <RadioButton Content="2h" GroupName="HistoryRange" Tag="2" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryRange_Checked" />
                                <RadioButton Content="3h" GroupName="HistoryRange" Tag="3" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryRange_Checked" />
                                <RadioButton Content="5h" GroupName="HistoryRange" Tag="5" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryRange_Checked" />
                                <RadioButton Content="24h" GroupName="HistoryRange" Tag="24" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryRange_Checked" />
                                <RadioButton Content="3d" GroupName="HistoryRange" Tag="72" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryRange_Checked" />
                                <RadioButton Content="7d" GroupName="HistoryRange" Tag="168" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryRange_Checked" />
                                <Button Content="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="HistoryPrev_Click" Margin="12,0,0,0" ToolTip="Earlier" AutomationProperties.Name="Earlier" />
                                <Button Content="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="HistoryNext_Click" Margin="6,0,0,0" ToolTip="Later" AutomationProperties.Name="Later" />
                                <Button Content="Now" Padding="12,4" FontSize="11" VerticalAlignment="Center" Click="HistoryNow_Click" Margin="6,0,0,0" />
                                <ToggleButton x:Name="HistoryCompareToggle" Content="Compare" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryCompare_Click" Unchecked="HistoryCompare_Click"
                                              ToolTip="Draws the same length of time just before this one as a dashed line, and compares their averages and peaks" />
                                <RadioButton x:Name="HistoryMetricCpu" Content="CPU" GroupName="HistoryMetric" Tag="cpu" Style="{StaticResource PillToggle}" IsChecked="True" Margin="16,0,0,0" Checked="HistoryMetric_Checked" />
                                <RadioButton Content="Memory" GroupName="HistoryMetric" Tag="mem" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryMetric_Checked" />
                                <RadioButton Content="GPU" GroupName="HistoryMetric" Tag="gpu" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryMetric_Checked" />
                                <RadioButton Content="FPS" GroupName="HistoryMetric" Tag="fps" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryMetric_Checked"
                                             ToolTip="Frames per second of the app in front — a game while you play it. Pick an app below to see its own. Per minute, the minute's lowest." />
                                <RadioButton x:Name="HistoryMetricDisk" Content="Disk" GroupName="HistoryMetric" Tag="disk" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryMetric_Checked" />
                                <RadioButton x:Name="HistoryMetricNet" Content="Network" GroupName="HistoryMetric" Tag="net" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryMetric_Checked" />
                                <RadioButton x:Name="HistoryMetricPower" Content="Power" GroupName="HistoryMetric" Tag="power" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryMetric_Checked" ToolTip="CPU + GPU power draw, W" />
                                <RadioButton x:Name="HistoryMetricFan" Content="Fans" GroupName="HistoryMetric" Tag="fan" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryMetric_Checked" ToolTip="The fastest fan, RPM" />
                                <RadioButton x:Name="HistoryMetricBattery" Content="Battery" GroupName="HistoryMetric" Tag="battery" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="HistoryMetric_Checked" Visibility="Collapsed" />
                                <Button x:Name="HistoryAppChip" Visibility="Collapsed" Padding="10,4" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"
                                        Click="HistoryAppClear_Click" ToolTip="Back to the whole PC" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="CompareText" DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed" />
                        <!-- On the Power chart: what the electricity in view cost -->
                        <WrapPanel x:Name="EnergyPanel" DockPanel.Dock="Top" Margin="0,0,0,10" Visibility="Collapsed">
                            <WrapPanel.Resources>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Padding" Value="4,1" />
                                    <Setter Property="Margin" Value="4,0" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </WrapPanel.Resources>
                            <TextBlock Text="Electricity" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                            <TextBox x:Name="EnergyPriceBox" Width="60" TextChanged="EnergySetting_Changed" AutomationProperties.Name="Price per kilowatt-hour" />
                            <TextBox x:Name="EnergyCurrencyBox" Width="50" MaxLength="8" TextChanged="EnergySetting_Changed" AutomationProperties.Name="Currency" />
                            <TextBlock Text="per kWh, plus" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                            <TextBox x:Name="EnergyExtraBox" Width="50" TextChanged="EnergySetting_Changed" AutomationProperties.Name="Watts for the rest of the PC"
                                     ToolTip="The sensors give only the CPU and GPU. Add what the rest takes — motherboard, memory, drives, fans, the power supply's loss: roughly 30–60 W on a desktop, 5–10 W on a laptop. The screen isn't counted." />
                            <TextBlock Text="W for the rest of the PC" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock x:Name="EnergyText" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </WrapPanel>
                        <!-- Chart over the app lists, split by a bar that resizes the lists (the height is remembered) -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="220" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="HistoryListsRow" Height="160" MinHeight="70" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Bottom" Height="46" Margin="0,8,0,0">
                                    <ComboBox x:Name="NavigatorSpanCombo" DockPanel.Dock="Left" Width="110" VerticalAlignment="Center" SelectionChanged="NavigatorSpan_Changed" AutomationProperties.Name="Overview span">
                                        <ComboBoxItem Content="1 hour" Tag="1" />
                                        <ComboBoxItem Content="2 hours" Tag="2" />
                                        <ComboBoxItem Content="3 hours" Tag="3" />
                                        <ComboBoxItem Content="1 day" Tag="24" IsSelected="True" />
                                        <ComboBoxItem Content="3 days" Tag="72" />
                                        <ComboBoxItem Content="7 days" Tag="168" />
                                        <ComboBoxItem Content="30 days" Tag="720" />
                                        <ComboBoxItem Content="Everything" Tag="0" />
                                    </ComboBox>
                                    <Button DockPanel.Dock="Right" Content="Report" Margin="8,0,0,0" VerticalAlignment="Center" Click="Report_Click"
                                            ToolTip="The last 7 days of this PC and every watched one, as a page in your browser (also made on its own every Monday)" />
                                    <Button DockPanel.Dock="Right" Content="Export…" Margin="8,0,0,0" VerticalAlignment="Center" Click="ExportHistory_Click" ToolTip="Save what the chart shows as CSV files (Excel opens them)" />
                                    <ComboBox x:Name="RetentionCombo" DockPanel.Dock="Right" Width="190" VerticalAlignment="Center" SelectionChanged="Retention_Changed" AutomationProperties.Name="Keep history for"
                                              ToolTip="How long the history is kept. About 1.5 MB per day, packed; days past the limit are removed at midnight.">
                                        <ComboBoxItem Content="Keep 1 month (~45 MB)" Tag="30" />
                                        <ComboBoxItem Content="Keep 3 months (~140 MB)" Tag="90" />
                                        <ComboBoxItem Content="Keep 6 months (~280 MB)" Tag="180" />
                                        <ComboBoxItem Content="Keep 1 year (~560 MB)" Tag="365" />
                                    </ComboBox>
                                    <Border x:Name="HistoryNavigatorBorder" Margin="8,0" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                                        <Canvas x:Name="HistoryNavigator" Background="Transparent" Cursor="Hand" ToolTip="Drag to move through the history"
                                                MouseLeftButtonDown="Navigator_MouseDown" MouseMove="Navigator_MouseMove" MouseLeftButtonUp="Navigator_MouseUp" />
                                    </Border>
                                </DockPanel>
                                <Canvas x:Name="HistoryAxis" DockPanel.Dock="Bottom" Height="16" Margin="0,4,0,0" ClipToBounds="True" />
                                <Border x:Name="HistoryChartBorder" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <Canvas x:Name="HistoryChart" Background="Transparent" Cursor="Cross"
                                                MouseMove="HistoryChart_MouseMove" MouseLeave="HistoryChart_MouseLeave" MouseLeftButtonDown="HistoryChart_MouseDown" MouseLeftButtonUp="HistoryChart_MouseUp" MouseWheel="HistoryChart_MouseWheel"
                                                MouseRightButtonDown="HistoryChart_MouseRightDown" MouseRightButtonUp="HistoryChart_MouseRightUp" />
                                        <TextBlock x:Name="HistoryRangeText" Margin="12,0,0,56" HorizontalAlignment="Left" VerticalAlignment="Bottom" Foreground="{DynamicResource TextSecondary}" FontSize="11" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                            </DockPanel>
                            <GridSplitter Grid.Row="1" Height="12" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                          Cursor="SizeNS" ToolTip="Drag to resize" AutomationProperties.Name="Resize the app lists" DragCompleted="HistorySplitter_DragCompleted">
                                <GridSplitter.Template>
                                    <ControlTemplate TargetType="GridSplitter">
                                        <Border Background="Transparent">
                                            <Border Width="44" Height="4" CornerRadius="2" Background="{DynamicResource ScrollThumb}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </GridSplitter.Template>
                            </GridSplitter>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DockPanel>
                                    <TextBlock x:Name="HistoryCursorTitle" DockPanel.Dock="Top" Text="Hover to see what was running · click to pin a moment · drag across a stretch or scroll to zoom · click an app below to chart it · right-drag to move, right-click to clear" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" />
                                    <ItemsControl x:Name="HistoryCursorList" Style="{StaticResource VirtualList}" ItemTemplate="{StaticResource HistoryAppRowTemplate}" />
                                </DockPanel>
                                <DockPanel Grid.Column="2">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <CheckBox x:Name="HistoryMeasuredCheck" DockPanel.Dock="Right" Content="Measured by Windows" FontSize="11" Visibility="Collapsed" Click="HistoryMeasured_Click"
                                                  ToolTip="Rank the apps by the energy Windows itself recorded (screen, disk and network included) instead of the estimate from CPU and GPU use. Windows writes it about once an hour and keeps about a week." />
                                        <TextBlock x:Name="HistoryRangeTitle" Text="TOP APPS IN THIS RANGE" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ItemsControl x:Name="HistoryRangeList" Style="{StaticResource VirtualList}" ItemTemplate="{StaticResource HistoryAppRowTemplate}" />
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Disks">
                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                        <StackPanel>
                            <Border x:Name="DriveHealthPanel" Visibility="Collapsed" Margin="16,16,16,0" Padding="14,10" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaseLabel}" Tag="Drive health" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ItemsControl x:Name="DriveHealthList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,5">
                                                    <Border x:Name="Chip" DockPanel.Dock="Right" Padding="9,2" CornerRadius="{DynamicResource PillRadius}" BorderThickness="1" VerticalAlignment="Center"
                                                            BorderBrush="{DynamicResource StatusGood}">
                                                        <TextBlock x:Name="ChipText" Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource StatusGood}" />
                                                    </Border>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Tag}" Value="warn">
                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource StatusWarn}" />
                                                        <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusWarn}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tag}" Value="bad">
                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource StatusBad}" />
                                                        <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusBad}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="DiskCardsHost" Margin="16,16,4,4" VerticalAlignment="Top">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Network">
                    <DockPanel Margin="16">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="DNS" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,8" />
                            <DockPanel>
                                <ComboBox x:Name="DnsAdapterCombo" DockPanel.Dock="Left" Width="200" Margin="0,0,10,0" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Automatic" Tag="0" Click="SetDns_Click" Margin="0,0,6,0" />
                                    <Button Content="Cloudflare" Tag="1" Click="SetDns_Click" Margin="0,0,6,0" />
                                    <Button Content="Google" Tag="2" Click="SetDns_Click" Margin="0,0,6,0" />
                                    <Button Content="Quad9" Tag="3" Click="SetDns_Click" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                        <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                            <ItemsControl x:Name="NetCardsHost" VerticalAlignment="Top">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Optimize">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,14,16,0">
                            <RadioButton Content="Cleanup" GroupName="OptimizePages" Tag="{Binding ElementName=CleanupPage}" Style="{StaticResource PillToggle}" IsChecked="True" Checked="SubPage_Checked" />
                            <RadioButton Content="Tweaks" GroupName="OptimizePages" Tag="{Binding ElementName=TweaksPage}" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="SubPage_Checked" />
                            <RadioButton Content="Startup" GroupName="OptimizePages" Tag="{Binding ElementName=StartupPage}" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="SubPage_Checked" />
                            <RadioButton Content="Services" GroupName="OptimizePages" Tag="{Binding ElementName=ServicesPage}" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="SubPage_Checked" />
                            <RadioButton Content="Debloat" GroupName="OptimizePages" Tag="{Binding ElementName=DebloatPage}" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="SubPage_Checked" />
                            <RadioButton Content="Uninstall" GroupName="OptimizePages" Tag="{Binding ElementName=UninstallPage}" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="SubPage_Checked" />
                            <RadioButton Content="Install" GroupName="OptimizePages" Tag="{Binding ElementName=InstallPage}" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="SubPage_Checked" />
                            <RadioButton Content="Schedule" GroupName="OptimizePages" Tag="{Binding ElementName=SchedulePage}" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="SubPage_Checked" />
                        </StackPanel>
                        <Grid>
                            <Border x:Name="CleanupPage">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Analyze" Click="AnalyzeCleanup_Click" Margin="0,0,8,0" />
                                        <Button Content="Clean selected" Style="{StaticResource PrimaryButton}" Click="Clean_Click" />
                                    </StackPanel>
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="CleanupList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource TextSecondary}"
                                                                       VerticalAlignment="Top" Typography.NumeralAlignment="Tabular" />
                                                            <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border x:Name="TweaksPage" Visibility="Collapsed">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Create restore point" Click="CreateRestorePoint_Click" Margin="0,0,8,0" />
                                        <Button Content="Restart Explorer" Click="RestartExplorer_Click" Margin="0,0,16,0" />
                                        <Button Content="Export..." Click="ExportTweaks_Click" Margin="0,0,8,0" />
                                        <Button Content="Import..." Click="ImportTweaks_Click" Margin="0,0,16,0" />
                                        <Button Content="Revert selected" Click="RevertTweaks_Click" Margin="0,0,8,0" />
                                        <Button Content="Apply selected" Style="{StaticResource PrimaryButton}" Click="ApplyTweaks_Click" />
                                    </StackPanel>
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="TweaksList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" FontSize="11" />
                                                            <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border x:Name="StartupPage" Visibility="Collapsed">
                                <DockPanel Margin="16">
                                    <Border DockPanel.Dock="Top" Padding="14,10" Margin="0,0,0,12" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="BootsSummary" Text="Reading Windows' starts…" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <ItemsControl x:Name="BootsList" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,3">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" />
                                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Enable selected" Click="EnableStartup_Click" Margin="0,0,8,0" />
                                        <Button Content="Disable selected" Style="{StaticResource PrimaryButton}" Click="DisableStartup_Click" />
                                    </StackPanel>
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="StartupList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" />
                                                            <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border x:Name="ServicesPage" Visibility="Collapsed">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Re-enable selected" Click="EnableServices_Click" Margin="0,0,8,0" />
                                        <Button Content="Stop and disable selected" Style="{StaticResource PrimaryButton}" Click="DisableServices_Click" />
                                    </StackPanel>
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="ServicesList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" />
                                                            <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border x:Name="DebloatPage" Visibility="Collapsed">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Remove selected" Style="{StaticResource PrimaryButton}" Click="RemoveBloatware_Click" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                               Text="Pre-installed apps most people never open. Removing one affects this PC only; most can be reinstalled from the Microsoft Store." />
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="BloatwareList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}"
                                                            Padding="10" Margin="0,0,10,10" Width="220">
                                                        <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Note}" Foreground="{DynamicResource TextSecondary}" FontSize="10" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border x:Name="UninstallPage" Visibility="Collapsed">
                                <DockPanel Margin="16">
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                        <ItemsControl x:Name="LeftoversList" Margin="0,0,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                                        <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="DeleteLeftoversButton" Content="Delete leftover folders" Click="DeleteLeftovers_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                                            <Button Content="Uninstall selected" Style="{StaticResource PrimaryButton}" Click="UninstallApps_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="InstalledAppsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" />
                                                            <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border x:Name="SchedulePage" Visibility="Collapsed">
                                <DockPanel Margin="16">
                                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,10"
                                               Text="Run things on their own — on this PC or a watched one. Each runs once on its day, within 10 minutes of its time; a PC that's off then skips it (or schedule a Wake up a few minutes before)." />
                                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <ComboBox x:Name="ScheduleActionCombo" Width="200" Margin="0,0,8,6" AutomationProperties.Name="What to do" />
                                        <TextBlock Text="on" VerticalAlignment="Center" Margin="0,0,8,6" />
                                        <ComboBox x:Name="SchedulePcCombo" Width="150" Margin="0,0,8,6" AutomationProperties.Name="Which PC" />
                                        <ComboBox x:Name="ScheduleDaysCombo" Width="170" Margin="0,0,8,6" AutomationProperties.Name="Which days" />
                                        <TextBlock Text="at" VerticalAlignment="Center" Margin="0,0,8,6" />
                                        <TextBox x:Name="ScheduleTimeBox" Width="70" Text="3:00" VerticalContentAlignment="Center" Margin="0,0,8,6" AutomationProperties.Name="Time, hours and minutes" />
                                        <Button Content="Add" Style="{StaticResource PrimaryButton}" Click="ScheduleAdd_Click" Margin="0,0,0,6" />
                                    </WrapPanel>
                                    <TextBlock x:Name="ScheduleStatus" DockPanel.Dock="Top" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,8" />
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="ScheduleList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="Remove" Tag="{Binding Tag}" Click="ScheduleRemove_Click" AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}" />
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border x:Name="InstallPage" Visibility="Collapsed">
                                <DockPanel Margin="16">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <TextBox x:Name="InstallSearchBox" DockPanel.Dock="Left" Width="260" VerticalContentAlignment="Center" MaxLength="100" AutomationProperties.Name="Search the winget catalog"
                                                 ToolTip="Search every app winget can install; empty = the popular list" KeyDown="InstallSearch_KeyDown" TextChanged="InstallSearch_TextChanged" />
                                        <Button x:Name="InstallSearchButton" DockPanel.Dock="Left" Content="Search" Margin="8,0,0,0" Click="SearchApps_Click" />
                                        <Button x:Name="InstallClearButton" DockPanel.Dock="Left" Content="Clear" Margin="8,0,0,0" Click="ClearAppSearch_Click" Visibility="Collapsed"
                                                ToolTip="Back to the popular apps" />
                                        <TextBlock x:Name="InstallSearchStatus" Text="Popular apps" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button x:Name="UpgradeAllButton" Content="Update all (winget)" Click="UpgradeAll_Click" Margin="0,0,8,0" />
                                        <Button x:Name="InstallSelectedButton" Content="Install selected" Style="{StaticResource PrimaryButton}" Click="InstallApps_Click" />
                                    </StackPanel>
                                    <WrapPanel x:Name="RemoteInstallPanel" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,12,0,0">
                                        <Button Content="Install a file…" Click="InstallRemoteFile_Click" Margin="0,0,8,6"
                                                ToolTip="Send an .exe or .msi (up to 512 MB) to the PC being shown and run it there" />
                                        <TextBox x:Name="InstallLinkBox" Width="300" MaxLength="2048" VerticalContentAlignment="Center" Margin="0,0,8,6" AutomationProperties.Name="Link to an installer"
                                                 ToolTip="An https:// link to an .exe or .msi: the PC being shown downloads it itself, with no size limit" />
                                        <Button Content="Install from link" Click="InstallRemoteLink_Click" Margin="0,0,16,6" />
                                        <TextBlock Text="Options" VerticalAlignment="Center" Margin="0,0,6,6" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBox x:Name="InstallArgsBox" Width="160" MaxLength="1024" VerticalContentAlignment="Center" Margin="0,0,0,6" AutomationProperties.Name="Installer options"
                                                 ToolTip="Passed to an .exe installer (a file or a link), such as /S, /silent or /quiet. Without them, the installer waits for someone to click through it on that PC. An .msi always installs quietly." />
                                    </WrapPanel>
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="AppsList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}"
                                                            Padding="10" Margin="0,0,10,10" Width="220">
                                                        <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" ToolTip="{Binding Description}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Files">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,14,16,0">
                            <RadioButton Content="Duplicates" GroupName="FilesPages" Tag="{Binding ElementName=DuplicatesPage}" Style="{StaticResource PillToggle}" IsChecked="True" Checked="SubPage_Checked" />
                            <RadioButton Content="Large files" GroupName="FilesPages" Tag="{Binding ElementName=LargeFilesPage}" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="SubPage_Checked" />
                        </StackPanel>
                        <Grid>
                            <Border x:Name="DuplicatesPage">
                                <DockPanel Margin="16">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Content="Scan" Click="ScanDuplicates_Click" Margin="8,0,0,0" />
                                        <TextBox x:Name="DuplicatesFolderBox" DockPanel.Dock="Right" Width="260" Margin="8,0,0,0" VerticalContentAlignment="Center" />
                                        <Button Content="Browse..." Click="BrowseDuplicatesFolder_Click" HorizontalAlignment="Left" />
                                    </DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Delete selected" Style="{StaticResource PrimaryButton}" Click="DeleteDuplicates_Click" />
                                    </StackPanel>
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="DuplicatesList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                            <ItemsControl ItemsSource="{Binding Files}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <DockPanel Margin="0,2">
                                                                            <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                                                <TextBlock Text="{Binding Description}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                            </CheckBox>
                                                                        </DockPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border x:Name="LargeFilesPage" Visibility="Collapsed">
                                <DockPanel Margin="16">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Content="Scan" Click="ScanLargeFiles_Click" Margin="8,0,0,0" />
                                        <TextBox x:Name="LargeFilesFolderBox" DockPanel.Dock="Right" Width="260" Margin="8,0,0,0" VerticalContentAlignment="Center" />
                                        <Button Content="Browse..." Click="BrowseLargeFilesFolder_Click" HorizontalAlignment="Left" />
                                    </DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Delete selected" Style="{StaticResource PrimaryButton}" Click="DeleteLargeFiles_Click" />
                                    </StackPanel>
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                                        <ItemsControl x:Name="LargeFilesList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" Typography.NumeralAlignment="Tabular" />
                                                            <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="About">
                    <ScrollViewer Style="{StaticResource GlassScrollViewer}">
                        <StackPanel Margin="16" MaxWidth="640" HorizontalAlignment="Left">
                            <StackPanel.Resources>
                                <Style TargetType="Hyperlink"><Setter Property="Foreground" Value="{DynamicResource Accent}" /></Style>
                            </StackPanel.Resources>
                            <TextBlock Text="Sysoptimizer" FontSize="28" FontWeight="Bold" />
                            <TextBlock x:Name="AboutVersionText" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,6" />
                            <TextBlock Text="Watches, records and tidies up your PC — by Protagonist Labs." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,20" />

                            <Border Padding="18,6" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel.Resources>
                                        <Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Border}" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="Padding" Value="0,10" /></Style>
                                    </StackPanel.Resources>
                                    <Border>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Hyperlink x:Name="CheckUpdatesLink" Click="CheckUpdatesLink_Click">Check for updates</Hyperlink></TextBlock>
                                            <TextBlock Text="Sysoptimizer also checks on its own and offers new versions as they come out." Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Hyperlink Click="ConnectClaude_Click">Connect to Claude</Hyperlink></TextBlock>
                                            <TextBlock Text="Lets Claude read your recorded history and answer questions like &quot;what slowed my PC down yesterday?&quot;" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Hyperlink NavigateUri="mailto:feedback@protagonistlabs.app?subject=Sysoptimizer%20feedback" RequestNavigate="Link_Navigate">Send feedback</Hyperlink></TextBlock>
                                            <TextBlock Text="feedback@protagonistlabs.app — bugs, ideas, anything." Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Hyperlink NavigateUri="https://protagonistlabs.app/sysoptimizer/?utm_source=sysoptimizer&amp;utm_medium=app&amp;utm_campaign=about" RequestNavigate="Link_Navigate">Website</Hyperlink></TextBlock>
                                            <TextBlock Text="protagonistlabs.app/sysoptimizer" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <Border BorderThickness="0">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Hyperlink NavigateUri="https://protagonistlabs.app/?utm_source=sysoptimizer&amp;utm_medium=app&amp;utm_campaign=more-apps" RequestNavigate="Link_Navigate">More apps from Protagonist Labs</Hyperlink></TextBlock>
                                            <TextBlock Text="protagonistlabs.app" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource CaseLabel}" Tag="Remote monitoring" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,24,0,8" />
                            <Border Padding="18,14" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Share this PC's history" FontWeight="SemiBold" />
                                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"
                                               Text="Lets another PC running Sysoptimizer watch this one's history, without remote desktop and its overhead. Encrypted, and only for whoever has the access key or password — which also lets that PC act here (install and update apps, end an app, clean up, restart or shut down), so share it only with PCs you trust. The firewall is opened for private networks only." />
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="RemoteServerCheck" Content="Allow, on port" VerticalAlignment="Center" Click="RemoteServer_Click" />
                                        <TextBox x:Name="RemotePortBox" Width="76" Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Port" />
                                    </StackPanel>
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Content="New key" Click="RemoteNewKey_Click" Margin="6,0,0,0" ToolTip="Make a new key: PCs using the old one lose access" />
                                        <Button DockPanel.Dock="Right" Content="Copy" Click="RemoteCopyKey_Click" Margin="6,0,0,0" />
                                        <TextBox x:Name="RemoteKeyBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" AutomationProperties.Name="Access key" />
                                    </DockPanel>
                                    <DockPanel Margin="0,6,0,0">
                                        <Button DockPanel.Dock="Right" Content="Use password" Click="RemoteUsePassword_Click" Margin="6,0,0,0"
                                                ToolTip="The key becomes this password's: PCs then connect with the password instead. At least 12 characters — it allows installs and restarts here." />
                                        <TextBlock DockPanel.Dock="Left" Text="or a password" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondary}" />
                                        <PasswordBox x:Name="RemotePasswordBox" VerticalAlignment="Center" AutomationProperties.Name="Password instead of the key" />
                                    </DockPanel>
                                    <TextBlock x:Name="RemoteServerStatus" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Padding="18,14" Margin="0,12,0,0" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Watch another PC" FontWeight="SemiBold" />
                                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"
                                               Text="Its name or IP address, port, and access key or password, as set in the About tab on that PC — or find the PCs sharing on this network. Then pick it under Showing, in the bar at the bottom." />
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,8,6">
                                            <TextBlock Style="{StaticResource CaseLabel}" Tag="Address" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                            <TextBox x:Name="RemoteAddressBox" Width="170" AutomationProperties.Name="Address of the PC to watch" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,6">
                                            <TextBlock Style="{StaticResource CaseLabel}" Tag="Port" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                            <TextBox x:Name="RemoteAddPortBox" Width="76" Text="7777" AutomationProperties.Name="Port of the PC to watch" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,6">
                                            <TextBlock Style="{StaticResource CaseLabel}" Tag="Access key or password" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                            <TextBox x:Name="RemoteAddKeyBox" Width="260" FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Access key or password of the PC to watch" />
                                        </StackPanel>
                                        <Button x:Name="RemoteAddButton" Content="Add" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,8,6" Click="RemoteAdd_Click" />
                                        <Button x:Name="RemoteFindButton" Content="Find on this network" VerticalAlignment="Bottom" Margin="0,0,0,6" Click="RemoteFind_Click"
                                                ToolTip="Ask the network which PCs share with Sysoptimizer on this port" />
                                    </WrapPanel>
                                    <ItemsControl x:Name="RemoteFoundList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,8,6" Click="RemoteFound_Click" AutomationProperties.Name="{Binding Name, StringFormat=Use {0}}">
                                                    <TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Description, Mode=OneWay}" /></TextBlock>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="RemoteAddStatus" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                    <ItemsControl x:Name="RemotePcList" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4">
                                                    <Button DockPanel.Dock="Right" Content="Remove" Tag="{Binding Name}" Click="RemoteRemove_Click" AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}" />
                                                    <CheckBox DockPanel.Dock="Right" Content="Alerts" Tag="{Binding Name}" IsChecked="{Binding IsChecked, Mode=OneTime}" Click="RemoteAlerts_Click" VerticalAlignment="Center" Margin="0,0,14,0"
                                                              ToolTip="Notify here when this PC runs hot, fills its memory or a disk, runs low on battery, or stops answering — the limits set in Processes → Events"
                                                              AutomationProperties.Name="{Binding Name, StringFormat=Alerts for {0}}" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Padding="18,14" Margin="0,12,0,0" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Phone page" FontWeight="SemiBold" />
                                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"
                                               Text="The PCs' cards in a phone's browser, on this network: readings only, no actions. Give it its own password — the page is plain HTTP, so the network can see it — never the one for remote monitoring." />
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="PhoneCheck" Content="Allow, on port" VerticalAlignment="Center" Click="Phone_Click" />
                                        <TextBox x:Name="PhonePortBox" Width="76" Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Phone page port" />
                                    </StackPanel>
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Content="Set password" Click="PhonePassword_Click" Margin="6,0,0,0" />
                                        <TextBlock DockPanel.Dock="Left" Text="Page password" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondary}" />
                                        <PasswordBox x:Name="PhonePasswordBox" VerticalAlignment="Center" AutomationProperties.Name="Phone page password" />
                                    </DockPanel>
                                    <TextBlock x:Name="PhoneStatus" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,10">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="LogToggle" Content="Log" Style="{StaticResource PillToggle}" IsChecked="False"
                                      ToolTip="Show or hide the log" AutomationProperties.Name="Show log" />
                        <TextBlock Style="{StaticResource CaseLabel}" Tag="Theme" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="24,0,8,0" />
                        <ComboBox x:Name="ThemeCombo" Width="190" VerticalAlignment="Center" AutomationProperties.Name="Theme"
                                  ToolTip="Hover a theme in the list to try it on; click to keep it" />
                        <TextBlock Style="{StaticResource CaseLabel}" Tag="Showing" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="24,0,8,0" />
                        <ComboBox x:Name="HistorySourceCombo" Width="150" VerticalAlignment="Center" SelectionChanged="HistorySource_Changed" AutomationProperties.Name="Which PC to show" ToolTip="This PC, or one added under About → Remote monitoring: Resources, Disks, Network, History and Events follow it" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer Style="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto" Height="114" Margin="0,4,0,0"
                              Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock x:Name="LogText" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource LogForeground}" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
