                                        </StackPanel>
                                    </Border>
                                    <Border>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Hyperlink Click="ConnectClaude_Click">Connect to Claude</Hyperlink></TextBlock>
                                            <TextBlock Text="Lets Claude read your recorded history and answer questions like &quot;what slowed my PC down yesterday?&quot;" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Hyperlink NavigateUri="mailto:feedback@protagonistlabs.app?subject=Sysoptimizer%20feedback" RequestNavigate="Link_Navigate">Send feedback</Hyperlink></TextBlock>
                                            <TextBlock Text="feedback@protagonistlabs.app — bugs, ideas, anything." Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Hyperlink NavigateUri="https://protagonistlabs.app/sysoptimizer/?utm_source=sysoptimizer&amp;utm_medium=app&amp;utm_campaign=about" RequestNavigate="Link_Navigate">Website</Hyperlink></TextBlock>
                                            <TextBlock Text="protagonistlabs.app/sysoptimizer" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <Border BorderThickness="0">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Hyperlink NavigateUri="https://protagonistlabs.app/?utm_source=sysoptimizer&amp;utm_medium=app&amp;utm_campaign=more-apps" RequestNavigate="Link_Navigate">More apps from Protagonist Labs</Hyperlink></TextBlock>
                                            <TextBlock Text="protagonistlabs.app" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource CaseLabel}" Tag="Remote monitoring" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,24,0,8" />
                            <Border Padding="18,14" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Share this PC's history" FontWeight="SemiBold" />
                                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"
                                               Text="Lets another PC running Sysoptimizer watch this one's history, without remote desktop and its overhead. Read-only, encrypted, and only for whoever has the access key. The firewall is opened for private networks only." />
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="RemoteServerCheck" Content="Allow, on port" VerticalAlignment="Center" Click="RemoteServer_Click" />
                                        <TextBox x:Name="RemotePortBox" Width="76" Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Port" />
                                    </StackPanel>
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Content="New key" Click="RemoteNewKey_Click" Margin="6,0,0,0" ToolTip="Make a new key: PCs using the old one lose access" />
                                        <Button DockPanel.Dock="Right" Content="Copy" Click="RemoteCopyKey_Click" Margin="6,0,0,0" />
                                        <TextBox x:Name="RemoteKeyBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" AutomationProperties.Name="Access key" />
                                    </DockPanel>
                                    <TextBlock x:Name="RemoteServerStatus" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Padding="18,14" Margin="0,12,0,0" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Watch another PC" FontWeight="SemiBold" />
                                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"
                                               Text="Its name or IP address, port and access key, as shown in the About tab on that PC. Then pick it under Showing, in the bar at the bottom." />
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,8,6">
                                            <TextBlock Style="{StaticResource CaseLabel}" Tag="Address" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                            <TextBox x:Name="RemoteAddressBox" Width="170" AutomationProperties.Name="Address of the PC to watch" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,6">
                                            <TextBlock Style="{StaticResource CaseLabel}" Tag="Port" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                            <TextBox x:Name="RemoteAddPortBox" Width="76" Text="7777" AutomationProperties.Name="Port of the PC to watch" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,6">
                                            <TextBlock Style="{StaticResource CaseLabel}" Tag="Access key" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                            <TextBox x:Name="RemoteAddKeyBox" Width="260" FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Access key of the PC to watch" />
                                        </StackPanel>
                                        <Button x:Name="RemoteAddButton" Content="Add" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,0,6" Click="RemoteAdd_Click" />
                                    </WrapPanel>
                                    <TextBlock x:Name="RemoteAddStatus" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                    <ItemsControl x:Name="RemotePcList" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4">
                                                    <Button DockPanel.Dock="Right" Content="Remove" Tag="{Binding Name}" Click="RemoteRemove_Click" AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}" />
                                                    <CheckBox DockPanel.Dock="Right" Content="Alerts" Tag="{Binding Name}" IsChecked="{Binding IsChecked, Mode=OneTime}" Click="RemoteAlerts_Click" VerticalAlignment="Center" Margin="0,0,14,0"
                                                              ToolTip="Notify here when this PC runs hot, fills its memory, or stops answering — the limits set in Processes → Events"
                                                              AutomationProperties.Name="{Binding Name, StringFormat=Alerts for {0}}" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,10">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource CaseLabel}" Tag="Log" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource CaseLabel}" Tag="Theme" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="24,0,8,0" />
                        <RadioButton x:Name="ThemeGlass" Content="Glass" GroupName="Theme" Tag="Glass" Style="{StaticResource PillToggle}" Checked="Theme_Checked" />
                        <RadioButton x:Name="ThemeStarTrek" Content="Star Trek" GroupName="Theme" Tag="StarTrek" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="Theme_Checked" />
                        <RadioButton x:Name="ThemeStarCraft" Content="StarCraft" GroupName="Theme" Tag="StarCraft" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="Theme_Checked" />
                        <RadioButton x:Name="ThemeCyberpunk" Content="Cyberpunk" GroupName="Theme" Tag="Cyberpunk" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Checked="Theme_Checked" />
                        <TextBlock Style="{StaticResource CaseLabel}" Tag="Showing" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="24,0,8,0" />
                        <ComboBox x:Name="HistorySourceCombo" Width="150" VerticalAlignment="Center" SelectionChanged="HistorySource_Changed" AutomationProperties.Name="Which PC to show" ToolTip="This PC, or one added under About → Remote monitoring: Resources, Disks, Network, History and Events follow it" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer Style="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource LogForeground}" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
