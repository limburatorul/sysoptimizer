<Project Sdk="Microsoft.NET.Sdk">

  <!-- Self-test of the recorded history (the part that's hardest to check by eye): dotnet run. No test
       framework on purpose — a failed check prints what broke and the exit code is 1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Sysoptimizer\Services\HistoryStore.cs" Link="HistoryStore.cs" />
    <Compile Include="..\Sysoptimizer\Services\RemoteHistory.cs" Link="RemoteHistory.cs" />
    <Compile Include="..\Sysoptimizer\Services\EnergyService.cs" Link="EnergyService.cs" />
    <Compile Include="..\Sysoptimizer\Services\WingetService.cs" Link="WingetService.cs" />
  </ItemGroup>

</Project>
