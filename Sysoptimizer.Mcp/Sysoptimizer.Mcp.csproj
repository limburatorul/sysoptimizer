<Project Sdk="Microsoft.NET.Sdk">

  <!-- A separate, non-elevated exe: the app itself requires admin, and an MCP client can't talk over
       stdio to a process that relaunches through a UAC prompt. It only reads the recorded history. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sysoptimizer-mcp</AssemblyName>
    <RootNamespace>Sysoptimizer.Mcp</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.0</Version>
    <Product>Sysoptimizer</Product>
    <AssemblyTitle>Sysoptimizer MCP connector</AssemblyTitle>
    <Description>Lets Claude read the resource history Sysoptimizer records</Description>
    <Company>Protagonist Labs</Company>
    <Authors>Protagonist Labs</Authors>
    <Copyright>Copyright (c) 2026 Protagonist Labs. MIT licence</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Sysoptimizer\Services\HistoryStore.cs" Link="HistoryStore.cs" />
  </ItemGroup>

</Project>
